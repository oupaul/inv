# 庫存管理系統 — 環境變數範例
# 複製為 .env 後依需求調整；所有變數皆有預設值，正式環境至少要設定 SESSION_SECRET。

# ===== 基本設定 =====
NODE_ENV=production
PORT=5000
PAGE_TITLE=庫存管理系統

# ===== 資料庫檔案 =====
DB_FILE=inventory.db
SESSION_DB_FILE=sessions.db
BACKUP_DIR=./backups

# ===== Session / Cookie =====
# 正式環境必須設定，長度 >= 32（可用：openssl rand -hex 32 產生）
SESSION_SECRET=
# session 有效時間（分鐘）
SESSION_MAX_AGE_MINUTES=1440
# 正式環境（HTTPS）建議設為 true
COOKIE_SECURE=false
# SSO 登入回呼是跨站 top-level 導向，需要 lax 才能帶 cookie；可設 strict/lax/none
COOKIE_SAMESITE=lax

# ===== M365 / Entra ID SSO（選填，四個值都設定才會啟用）=====
# 於 Entra App Registration 建立應用程式後取得
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# 需與 Entra 設定的重新導向 URI 完全一致，例如 https://your-host/auth/callback
SSO_REDIRECT_URI=

# ===== 分頁 / 安全性 =====
PAGE_SIZE=50
# 登入頻率限制（毫秒 / 次數）
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
# 允許的額外 Origin/Referer host（CSRF 防護白名單，逗號分隔），例如反向代理網域
ALLOWED_HOSTS=

# ===== 上傳限制（bytes）=====
UPLOAD_EXCEL_MAX_BYTES=10485760
UPLOAD_IMAGE_MAX_BYTES=15728640

# ===== 日誌 =====
# 留空則只輸出到 console；設定路徑則同時寫入檔案
LOG_FILE=
# debug / info / warn / error
LOG_LEVEL=info

# ===== 操作記錄保留天數（0 = 不自動清理）=====
ACTIVITY_LOG_RETENTION_DAYS=90

# ===== 時區 =====
TZ=Asia/Taipei
