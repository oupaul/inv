<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>料件出庫 - <%= typeof title !== 'undefined' ? title : '庫存管理系統' %></title>
    <style>
        <%- include('_common-styles') %>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: "Microsoft JhengHei", "PingFang TC", "Helvetica Neue", Arial, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            background-color: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        
        h1 {
            color: #333;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 3px solid #667eea;
            font-size: 28px;
            font-weight: 600;
        }
        
        nav {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 0;
            border-radius: 8px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            overflow: hidden;
        }
        
        .nav-wrapper {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            padding: 12px 15px;
            gap: 8px;
        }
        
        nav a {
            color: white;
            text-decoration: none;
            padding: 10px 16px;
            border-radius: 6px;
            display: inline-block;
            transition: all 0.3s;
            font-size: 14px;
            font-weight: 500;
            white-space: nowrap;
        }
        
        nav a:hover {
            background-color: rgba(255,255,255,0.2);
            transform: translateY(-2px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }
        
        nav a[href="/users"] {
            background-color: rgba(255,255,255,0.15);
            font-weight: 600;
            border: 1px solid rgba(255,255,255,0.3);
        }
        
        nav a[href="/users"]:hover {
            background-color: rgba(255,255,255,0.25);
        }
        
        nav .auth-link {
            margin-left: auto;
            background-color: rgba(255,255,255,0.2);
            font-weight: 600;
        }
        
        nav .auth-link.logout {
            background-color: #dc3545;
        }
        
        nav .auth-link.login {
            background-color: #007bff;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #555;
            font-size: 14px;
        }
        
        input[type="text"],
        input[type="number"],
        input[type="date"],
        input[type="password"],
        select,
        textarea {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 6px;
            font-size: 14px;
            transition: all 0.3s;
            font-family: inherit;
        }
        
        input:focus,
        select:focus,
        textarea:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        textarea {
            resize: vertical;
            min-height: 100px;
        }
        
        button {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.4);
        }
        
        .flash-messages {
            margin-bottom: 20px;
        }
        
        .flash {
            padding: 15px 20px;
            border-radius: 6px;
            margin-bottom: 10px;
            font-weight: 500;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        
        .flash.success {
            background-color: #d4edda;
            color: #155724;
            border-left: 4px solid #28a745;
        }
        
        .flash.error {
            background-color: #f8d7da;
            color: #721c24;
            border-left: 4px solid #dc3545;
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #999;
        }
        
        .empty-state p {
            font-size: 16px;
            margin-bottom: 10px;
        }
        
        .stock-info {
            color: #dc3545;
            font-weight: bold;
            margin-left: 10px;
        }
        
        @media (max-width: 768px) {
            .nav-wrapper {
                flex-direction: column;
                align-items: stretch;
            }
            
            nav a {
                width: 100%;
                text-align: center;
                margin-bottom: 5px;
            }
            
            nav .auth-link {
                margin-left: 0;
            }
            
            .container {
                padding: 15px;
            }
            
            /* 表單手機版優化 */
            .form-group {
                margin-bottom: 18px;
            }
            
            input[type="text"],
            input[type="number"],
            input[type="date"],
            select,
            textarea {
                font-size: 16px !important;
                padding: 14px !important;
                -webkit-appearance: none;
            }
            
            button,
            .btn {
                width: 100% !important;
                min-height: 48px !important;
                font-size: 16px !important;
                padding: 14px 20px !important;
                margin-bottom: 10px;
            }
            
            .barcode-input-group {
                flex-direction: column !important;
                gap: 10px !important;
            }
            
            .barcode-input-group input,
            .barcode-input-group button {
                width: 100% !important;
            }
        }
    </style>
</head>
<body>
    <a href="/" class="back-to-home">← 返回主頁</a>
    <%- include('_common-nav') %>
    
    <div class="container">
        <% if (messages && messages.length > 0) { %>
            <div class="flash-messages">
                <% messages.forEach(function(msg) { %>
                    <div class="flash <%= msg.category %>"><%= msg.message %></div>
                <% }); %>
            </div>
        <% } %>

        <%
            // 出庫帶發票的提示卡片（從 URL query 參數取得）
            const invPrompt  = typeof query !== 'undefined' && query.inv_prompt === '1';
            const invObId    = typeof query !== 'undefined' ? (query.ob_id || '') : '';
            const invNo      = typeof query !== 'undefined' ? (query.inv_no || '') : '';
        %>
        <% if (invPrompt && invObId) { %>
        <div style="background:linear-gradient(135deg,#ecfdf5,#d1fae5); border:1px solid #6ee7b7; border-left:5px solid #10b981; border-radius:12px; padding:18px 22px; margin-bottom:20px; display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
            <div style="display:flex; align-items:flex-start; gap:14px;">
                <span style="font-size:28px; flex-shrink:0;">🧾</span>
                <div>
                    <div style="font-weight:700; font-size:15px; color:#065f46; margin-bottom:4px;">出庫成功！已記錄發票號碼</div>
                    <div style="font-size:20px; font-weight:800; color:#047857; letter-spacing:1px; margin-bottom:6px;"><%= invNo %></div>
                    <div style="font-size:13px; color:#059669;">是否建立完整的發票管理記錄？（可追蹤付款狀態、稅額、客戶資訊）</div>
                </div>
            </div>
            <div style="display:flex; gap:10px; flex-shrink:0;">
                <a href="/invoices/add?outbound_ids=<%= invObId %>&invoice_number=<%= encodeURIComponent(invNo) %>"
                   style="display:inline-flex; align-items:center; gap:6px; background:#10b981; color:white; border:none; border-radius:8px; padding:10px 18px; font-size:14px; font-weight:600; text-decoration:none; cursor:pointer;">
                    📋 建立完整發票記錄
                </a>
                <a href="/" style="display:inline-flex; align-items:center; background:white; color:#6b7280; border:1px solid #d1d5db; border-radius:8px; padding:10px 14px; font-size:14px; text-decoration:none;">
                    稍後處理
                </a>
            </div>
        </div>
        <% } %>

        <h1>📤 料件出庫</h1>

        <% if (typeof activeCheckSession !== 'undefined' && activeCheckSession) { %>
        <div style="background-color: #fff3cd; border: 2px solid #ffc107; border-radius: 8px; padding: 12px 15px; margin-bottom: 20px; color: #856404; font-size: 14px;">
            📋 目前有進行中的盤點事件：<strong><%= activeCheckSession.session_name || activeCheckSession.session_date %></strong>，盤點期間異動庫存可能會讓盤點數字需要重新核對。
        </div>
        <% } %>

        <!-- 無線掃描器使用提示 -->
        <div style="background-color: #fff3cd; border: 2px solid #ffc107; border-radius: 8px; padding: 15px; margin-bottom: 20px;">
            <strong style="color: #856404; font-size: 15px;">📱 無線掃描器快速出庫：</strong>
            <ul style="margin: 10px 0; padding-left: 20px; color: #856404; font-size: 14px; line-height: 1.8;">
                <li><strong>DK-ONE 頸掛式藍芽掃描器</strong>可直接使用！</li>
                <li>確保掃描器已連接，點擊下方「條碼掃描」輸入框使其聚焦</li>
                <li>直接掃描條碼，系統會自動查詢料件並填入表單</li>
                <li>確認數量和日期後，點擊「出庫」按鈕提交</li>
            </ul>
        </div>

        <% if (parts && parts.length > 0) { %>
        <form method="POST" id="outboundForm">
            <div class="form-group">
                <label>條碼掃描</label>
                <div style="margin-bottom: 10px; padding: 15px; background-color: #f8f9fa; border-radius: 6px; border: 2px solid #e0e0e0;">
                    <div style="display: flex; gap: 10px; margin-bottom: 10px; flex-wrap: wrap;">
                        <input type="text" id="barcode-input" placeholder="掃描或輸入條碼" style="flex: 1; min-width: 200px; padding: 10px; border: 2px solid #ddd; border-radius: 6px; font-size: 14px;">
                        <button type="button" id="barcode-scan" style="background: linear-gradient(135deg, #007bff 0%, #0056b3 100%); color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;">📷 掃描</button>
                        <button type="button" id="barcode-lookup" style="background: linear-gradient(135deg, #28a745 0%, #218838 100%); color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;">🔍 查詢</button>
                        <button type="button" id="barcode-clear" style="background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%); color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;">🗑️ 清除</button>
                    </div>
                    <div id="barcode-camera" style="display: none; margin-top: 10px;">
                        <video id="barcode-video" autoplay playsinline style="width: 100%; max-width: 640px; border: 2px solid #667eea; border-radius: 6px;"></video>
                        <button type="button" id="stop-scan" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; margin-top: 10px; font-weight: 600;">停止掃描</button>
                    </div>
                    <div id="barcode-status" style="display: none; padding: 10px; border-radius: 6px; margin-top: 10px;"></div>
                </div>
                <small style="color: #666; margin-top: 5px; display: block;">
                    💡 提示：點擊「掃描」按鈕使用手機攝像頭掃描條碼，或手動輸入條碼後點擊「查詢」。
                </small>
            </div>
            
            <div class="form-group">
                <label for="category_filter">類型篩選</label>
                <select id="category_filter" name="category_filter">
                    <option value="">-- 全部類型 --</option>
                    <% if (categories && categories.length > 0) { %>
                        <% categories.forEach(function(category) { %>
                        <option value="<%= category.id %>"><%= category.name %></option>
                        <% }); %>
                    <% } %>
                </select>
                <small style="color: #666; margin-top: 5px; display: block;">
                    💡 提示：先選擇類型可以快速篩選出對應的料件，方便查找。
                </small>
            </div>
            
            <div class="form-group">
                <label for="part_id">選擇料件 *</label>
                <select id="part_id" name="part_id" required>
                    <option value="">-- 請先選擇類型或掃描條碼 --</option>
                    <% const checkedInSession = (typeof activeCheckSession !== 'undefined' && activeCheckSession) ? activeCheckSession.checkedPartIds : []; %>
                    <% parts.forEach(function(part) { %>
                    <option value="<%= part.id %>"
                            data-stock="<%= part.current_stock %>"
                            data-min-stock="<%= part.min_stock || 0 %>"
                            data-unit="<%= part.unit || '' %>"
                            data-barcode="<%= part.barcode || '' %>"
                            data-category-id="<%= part.category_id || '' %>"
                            data-category-name="<%= part.category_name || '' %>"
                            data-checked-in-session="<%= checkedInSession.includes(part.id) ? '1' : '' %>">
                        <%= part.part_number %> - <%= part.part_name %>
                        <% if (part.specification) { %>(<%= part.specification %>)<% } %>
                        <% if (part.category_name) { %> [<%= part.category_name %>]<% } %>
                        (庫存: <%= part.current_stock %>)
                    </option>
                    <% }); %>
                </select>
                <!-- 即時庫存顯示卡片 -->
                <div id="stock-info-box" style="display:none; margin-top:10px; padding:10px 14px; border-left:4px solid #28a745; border-radius:6px; font-size:14px; background:#f0fff4;">
                    <span id="stock-info-text"></span>
                </div>
                <div id="check-session-warning-box" style="display:none; margin-top:10px; padding:10px 14px; background:#fff3cd; border-left:4px solid #ffc107; border-radius:6px; font-size:13px; color:#856404; font-weight:600;">
                    ⚠️ 此料件已於本次盤點事件中盤點過，異動後請留意盤點數字需要重新核對
                </div>
            </div>
            
            <div class="form-group">
                <label for="quantity">出庫數量 *</label>
                <input type="number" id="quantity" name="quantity" required min="1" placeholder="請輸入數量" max="">
            </div>
            
            <div class="form-group">
                <label for="outbound_date">出庫日期 *</label>
                <input type="date" id="outbound_date" name="outbound_date" required value="<%= today %>">
            </div>
            
            <div class="form-group">
                <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                    <input type="checkbox" id="is_loan" name="is_loan" style="width: auto; margin: 0;">
                    <span style="font-weight: 600; color: #667eea;">📤 借測（勾選此項表示此出庫為借測，不影響庫存計算）</span>
                </label>
                <small style="color: #666; margin-top: 5px; display: block;">
                    💡 提示：勾選「借測」後，此出庫記錄不會減少庫存數量，用於追蹤借出的料件。
                </small>
            </div>
            
            <!-- 借測相關欄位（勾選借測時顯示） -->
            <div class="form-group" id="loan-fields" style="display: none; padding: 15px; background-color: #f8f9fa; border-radius: 6px; border: 2px solid #e0e0e0;">
                <h3 style="margin-top: 0; margin-bottom: 15px; color: #667eea; font-size: 16px;">⏰ 借測時間設定</h3>
                
                <div class="form-group" style="margin-bottom: 0;">
                    <label for="loan_due_date">到期日期 <span id="loan-due-date-required" style="display: none;">*</span></label>
                    <input type="date" id="loan_due_date" name="loan_due_date">
                    <small style="color: #666; margin-top: 5px; display: block;">
                        ⚠️ 到期後系統會自動通知，請務必填寫正確的到期日期。借測開始日期為出庫日期。
                    </small>
                </div>
            </div>
            
            <div class="form-group">
                <label for="note">備註</label>
                <textarea id="note" name="note" placeholder="請輸入備註（選填）"></textarea>
            </div>
            
            <!-- 發票信息（僅非借測時顯示） -->
            <div class="form-group" id="invoice-fields" style="padding: 15px; background-color: #f0f8ff; border-radius: 6px; border: 2px solid #b3d9ff;">
                <h3 style="margin-top: 0; margin-bottom: 15px; color: #0066cc; font-size: 16px;">🧾 發票信息（選填）</h3>
                
                <div class="form-group" style="margin-bottom: 15px;">
                    <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                        <input type="checkbox" id="has_invoice" name="has_invoice" style="width: auto; margin: 0;">
                        <span style="font-weight: 600; color: #0066cc;">已開立發票</span>
                    </label>
                </div>
                
                <div class="form-group" id="invoice-number-group" style="margin-bottom: 0; display: none;">
                    <label for="invoice_number">發票號碼</label>
                    <input type="text" id="invoice_number" name="invoice_number" placeholder="請輸入發票號碼">
                    <small style="color: #666; margin-top: 5px; display: block;">
                        💡 提示：如有開立發票，請輸入發票號碼以便追蹤。
                    </small>
                </div>
            </div>
            
            <button type="submit" id="submitBtn">確認出庫</button>
            <a href="/" style="margin-left: 10px; color: #666; text-decoration: none;">取消</a>
        </form>
        <% } else { %>
        <div class="empty-state">
            <p>目前沒有任何有庫存的料件可以出庫</p>
            <p>請先前往<a href="/inbound">料件入庫</a>進行入庫</p>
        </div>
        <% } %>
    </div>
    
    <script src="https://unpkg.com/@zxing/library@latest"></script>
    <script>
        const { BrowserMultiFormatReader } = ZXing;
        const codeReader = new BrowserMultiFormatReader();
        let scanning = false;
        
        const barcodeInput = document.getElementById('barcode-input');
        const barcodeScan = document.getElementById('barcode-scan');
        const barcodeLookup = document.getElementById('barcode-lookup');
        const barcodeClear = document.getElementById('barcode-clear');
        const barcodeStatus = document.getElementById('barcode-status');
        const barcodeCamera = document.getElementById('barcode-camera');
        const video = document.getElementById('barcode-video');
        const stopScanBtn = document.getElementById('stop-scan');
        const categoryFilter = document.getElementById('category_filter');
        const partSelect = document.getElementById('part_id');
        const quantityInput = document.getElementById('quantity');
        const isLoanCheckbox = document.getElementById('is_loan');
        const loanFields = document.getElementById('loan-fields');
        const loanDueDate = document.getElementById('loan_due_date');
        const outboundDate = document.getElementById('outbound_date');
        
        // 儲存所有料件選項（用於篩選）
        const allPartOptions = Array.from(partSelect.options);
        
        // 類型篩選功能
        categoryFilter.addEventListener('change', function() {
            const selectedCategoryId = this.value;
            
            // 清除當前選擇
            partSelect.value = '';
            
            // 移除所有選項（保留第一個預設選項）
            while (partSelect.options.length > 1) {
                partSelect.remove(1);
            }
            
            // 根據選擇的類型篩選選項
            if (selectedCategoryId === '') {
                // 顯示全部
                allPartOptions.slice(1).forEach(option => {
                    partSelect.appendChild(option.cloneNode(true));
                });
                partSelect.querySelector('option[value=""]').textContent = '-- 請先選擇類型或掃描條碼 --';
            } else {
                // 只顯示符合類型的選項
                allPartOptions.slice(1).forEach(option => {
                    const categoryId = option.getAttribute('data-category-id');
                    if (categoryId === selectedCategoryId) {
                        partSelect.appendChild(option.cloneNode(true));
                    }
                });
                // 更新預設選項文字
                const filteredCount = partSelect.options.length - 1;
                if (filteredCount > 0) {
                    partSelect.querySelector('option[value=""]').textContent = `-- 請選擇料件（共 ${filteredCount} 項） --`;
                } else {
                    partSelect.querySelector('option[value=""]').textContent = '-- 此類型暫無可用料件 --';
                }
            }
            
            // 重置數量輸入框
            quantityInput.value = '';
            quantityInput.placeholder = '請輸入數量';
            quantityInput.removeAttribute('max');
        });
        
        // 更新數量上限與庫存顯示卡片
        partSelect.addEventListener('change', function() {
            const selectedOption = this.options[this.selectedIndex];
            const stock = selectedOption ? parseInt(selectedOption.getAttribute('data-stock')) || 0 : 0;
            const minStock = selectedOption ? parseInt(selectedOption.getAttribute('data-min-stock')) || 0 : 0;
            const unit = selectedOption ? (selectedOption.getAttribute('data-unit') || '') : '';
            const stockBox = document.getElementById('stock-info-box');
            const stockText = document.getElementById('stock-info-text');
            
            // 清除之前的數量輸入
            quantityInput.value = '';
            
            // 更新庫存顯示卡片
            if (stockBox && stockText && this.value) {
                const isLow = minStock > 0 && stock <= minStock;
                const color = stock <= 0 ? '#dc3545' : (isLow ? '#ff9800' : '#28a745');
                const warn = stock <= 0 ? ' ❌ 庫存不足！' : (isLow ? ` ⚠️ 低於最低庫存（${minStock}）` : '');
                const partName = selectedOption.textContent.split(' - ')[1]?.split('(')[0]?.trim() || '';
                stockText.innerHTML = `📦 目前可用庫存：<strong style="color:${color};font-size:18px;">${stock}</strong> ${unit}${warn}`;
                stockBox.style.borderLeftColor = color;
                stockBox.style.background = stock <= 0 ? '#fff5f5' : (isLow ? '#fffbf0' : '#f0fff4');
                stockBox.style.display = 'block';
            } else if (stockBox) {
                stockBox.style.display = 'none';
            }

            // 若此料件在目前進行中的盤點事件裡已經盤點過，提示（不擋止）
            const checkWarningBox = document.getElementById('check-session-warning-box');
            if (checkWarningBox) {
                checkWarningBox.style.display = (this.value && selectedOption && selectedOption.getAttribute('data-checked-in-session') === '1') ? 'block' : 'none';
            }

            if (stock > 0) {
                quantityInput.setAttribute('max', stock);
                quantityInput.placeholder = `請輸入數量（最多 ${stock}）`;
                quantityInput.removeAttribute('disabled');
            } else {
                quantityInput.removeAttribute('max');
                quantityInput.placeholder = '此料件暫無可用庫存';
                quantityInput.setAttribute('disabled', 'disabled');
            }
        });
        
        // 借測勾選事件處理
        const loanDueDateRequired = document.getElementById('loan-due-date-required');
        const hasInvoiceCheckbox = document.getElementById('has_invoice');
        const invoiceFields = document.getElementById('invoice-fields');
        const invoiceNumberGroup = document.getElementById('invoice-number-group');
        const invoiceNumberInput = document.getElementById('invoice_number');
        
        if (isLoanCheckbox) {
            // 確保初始狀態：未勾選時，到期日期不是必填的
            if (loanDueDate) {
                loanDueDate.required = false;
            }
            if (loanDueDateRequired) {
                loanDueDateRequired.style.display = 'none';
            }
            
            isLoanCheckbox.addEventListener('change', function() {
                if (this.checked) {
                    loanFields.style.display = 'block';
                    // 借測時隱藏發票欄位
                    if (invoiceFields) {
                        invoiceFields.style.display = 'none';
                    }
                    // 設置到期日期為必填
                    if (loanDueDate) {
                        loanDueDate.required = true;
                        // 預設到期日期為30天後（基於出庫日期）
                        if (outboundDate && outboundDate.value) {
                            const today = new Date(outboundDate.value);
                            today.setDate(today.getDate() + 30);
                            const dueDateStr = today.toISOString().split('T')[0];
                            loanDueDate.value = dueDateStr;
                            loanDueDate.setAttribute('min', outboundDate.value); // 到期日期不能早於出庫日期
                        }
                    }
                    if (loanDueDateRequired) {
                        loanDueDateRequired.style.display = 'inline';
                    }
                } else {
                    loanFields.style.display = 'none';
                    // 非借測時顯示發票欄位
                    if (invoiceFields) {
                        invoiceFields.style.display = 'block';
                    }
                    if (loanDueDate) {
                        loanDueDate.required = false;
                        loanDueDate.value = '';
                        loanDueDate.removeAttribute('min');
                    }
                    if (loanDueDateRequired) {
                        loanDueDateRequired.style.display = 'none';
                    }
                }
            });
            
            // 初始狀態：如果是借測，隱藏發票欄位；否則顯示
            if (invoiceFields) {
                if (isLoanCheckbox.checked) {
                    invoiceFields.style.display = 'none';
                } else {
                    invoiceFields.style.display = 'block';
                }
            }
        }
        
        // 發票勾選事件處理
        if (hasInvoiceCheckbox && invoiceNumberGroup) {
            hasInvoiceCheckbox.addEventListener('change', function() {
                if (this.checked) {
                    invoiceNumberGroup.style.display = 'block';
                } else {
                    invoiceNumberGroup.style.display = 'none';
                    if (invoiceNumberInput) {
                        invoiceNumberInput.value = '';
                    }
                }
            });
            
            // 初始狀態
            if (hasInvoiceCheckbox.checked) {
                invoiceNumberGroup.style.display = 'block';
            } else {
                invoiceNumberGroup.style.display = 'none';
            }
        }
        
        // 發票勾選事件處理
        if (hasInvoiceCheckbox && invoiceNumberGroup) {
            hasInvoiceCheckbox.addEventListener('change', function() {
                if (this.checked) {
                    invoiceNumberGroup.style.display = 'block';
                } else {
                    invoiceNumberGroup.style.display = 'none';
                    if (invoiceNumberInput) {
                        invoiceNumberInput.value = '';
                    }
                }
            });
            
            // 初始狀態
            if (hasInvoiceCheckbox.checked) {
                invoiceNumberGroup.style.display = 'block';
            } else {
                invoiceNumberGroup.style.display = 'none';
            }
            
            // 出庫日期改變時，更新到期日期相關設定（如果已勾選借測）
            if (outboundDate && loanDueDate) {
                outboundDate.addEventListener('change', function() {
                    if (isLoanCheckbox.checked) {
                        // 更新到期日期最小值
                        loanDueDate.setAttribute('min', this.value);
                        // 如果當前到期日期早於新的出庫日期，則更新為30天後
                        if (loanDueDate.value && loanDueDate.value < this.value) {
                            const today = new Date(this.value);
                            today.setDate(today.getDate() + 30);
                            loanDueDate.value = today.toISOString().split('T')[0];
                        }
                    }
                });
            }
        }
        
        // 表單提交驗證
        const outboundForm = document.getElementById('outboundForm');
        const submitBtn = document.getElementById('submitBtn');
        
        if (outboundForm) {
            outboundForm.addEventListener('submit', function(e) {
                console.log('表單提交事件觸發');
                
                // 檢查必填欄位
                if (!partSelect.value) {
                    e.preventDefault();
                    alert('請選擇料件！');
                    partSelect.focus();
                    return false;
                }
                
                const qty = parseInt(quantityInput.value) || 0;
                if (qty <= 0) {
                    e.preventDefault();
                    alert('請輸入有效的出庫數量！');
                    quantityInput.focus();
                    return false;
                }
                
                // 檢查數量是否超過庫存
                const maxQty = parseInt(quantityInput.getAttribute('max')) || 0;
                if (maxQty > 0 && qty > maxQty) {
                    e.preventDefault();
                    alert(`出庫數量不能超過可用庫存！可用庫存：${maxQty}，輸入數量：${qty}`);
                    quantityInput.focus();
                    return false;
                }
                
                // 借測相關驗證
                if (isLoanCheckbox && isLoanCheckbox.checked) {
                    if (!loanDueDate.value || loanDueDate.value.trim() === '') {
                        e.preventDefault();
                        alert('請填寫借測到期日期！');
                        loanDueDate.focus();
                        return false;
                    }
                    // 驗證到期日期不能早於出庫日期
                    if (loanDueDate.value < outboundDate.value) {
                        e.preventDefault();
                        alert('到期日期不能早於出庫日期！');
                        loanDueDate.focus();
                        return false;
                    }
                }
                
                // 如果所有驗證通過，顯示提交中狀態
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = '提交中...';
                }
                
                console.log('表單驗證通過，允許提交');
                return true;
            });
        }
        
        // 如果表單驗證失敗，重新啟用按鈕
        window.addEventListener('pageshow', function() {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = '確認出庫';
            }
        });
        
        // 掃描按鈕
        barcodeScan.addEventListener('click', async () => {
            if (scanning) return;
            
            try {
                scanning = true;
                barcodeScan.disabled = true;
                barcodeCamera.style.display = 'block';
                showStatus('正在啟動攝像頭...', 'info');
                
                await codeReader.decodeFromVideoDevice(null, 'barcode-video', (result, err) => {
                    if (result) {
                        barcodeInput.value = result.text;
                        showStatus('✓ 掃描成功：' + result.text, 'success');
                        stopScan();
                        
                        // 自動查詢條碼
                        lookupBarcode(result.text);
                    }
                    if (err && !(err instanceof ZXing.NotFoundException)) {
                        console.error(err);
                    }
                });
            } catch (error) {
                showStatus('✗ 無法啟動攝像頭：' + error.message, 'error');
                stopScan();
            }
        });
        
        // 停止掃描
        stopScanBtn.addEventListener('click', () => {
            stopScan();
        });
        
        function stopScan() {
            scanning = false;
            barcodeScan.disabled = false;
            codeReader.reset();
            barcodeCamera.style.display = 'none';
            if (video.srcObject) {
                video.srcObject.getTracks().forEach(track => track.stop());
                video.srcObject = null;
            }
        }
        
        // 查詢條碼
        async function lookupBarcode(barcode) {
            if (!barcode || !barcode.trim()) {
                showStatus('請輸入條碼', 'error');
                setTimeout(() => barcodeInput.focus(), 100);
                return;
            }
            
            try {
                showStatus('正在查詢...', 'info');
                const response = await fetch(`/api/barcode/${encodeURIComponent(barcode)}`);
                const data = await response.json();
                
                if (data.success && data.part) {
                    // 找到料件，檢查是否在當前篩選列表中
                    const option = Array.from(partSelect.options).find(opt => 
                        opt.value == data.part.id
                    );
                    
                    if (option) {
                        // 如果在當前列表中，直接選擇
                        partSelect.value = data.part.id;
                        partSelect.dispatchEvent(new Event('change'));
                        showStatus('✓ 找到料件：' + data.part.part_number + ' - ' + data.part.part_name, 'success');
                        // 清空條碼輸入框並重新聚焦，準備下一次掃描
                        setTimeout(() => {
                            barcodeInput.value = '';
                            barcodeInput.focus();
                        }, 300);
                    } else {
                        // 如果不在當前列表中（可能是因為類型篩選），先更新類型篩選，再選擇
                        // p.* 會返回 category_id，所以我們可以直接使用
                        const partCategoryId = data.part.category_id ? String(data.part.category_id) : '';
                        if (partCategoryId && categoryFilter.value !== partCategoryId) {
                            // 更新類型篩選
                            categoryFilter.value = partCategoryId;
                            categoryFilter.dispatchEvent(new Event('change'));
                            
                            // 等待 DOM 更新後再選擇
                            setTimeout(() => {
                                const newOption = Array.from(partSelect.options).find(opt => 
                                    opt.value == data.part.id
                                );
                                if (newOption) {
                                    partSelect.value = data.part.id;
                                    partSelect.dispatchEvent(new Event('change'));
                                    showStatus('✓ 找到料件：' + data.part.part_number + ' - ' + data.part.part_name + '（已自動切換到對應類型）', 'success');
                                    // 清空條碼輸入框並重新聚焦
                                    setTimeout(() => {
                                        barcodeInput.value = '';
                                        barcodeInput.focus();
                                    }, 300);
                                } else {
                                    showStatus('✗ 料件不在當前可用列表中或庫存為零', 'error');
                                    setTimeout(() => {
                                        barcodeInput.select();
                                        barcodeInput.focus();
                                    }, 1500);
                                }
                            }, 100);
                        } else if (!partCategoryId) {
                            showStatus('✗ 此料件未分類或不在列表中', 'error');
                            setTimeout(() => {
                                barcodeInput.select();
                                barcodeInput.focus();
                            }, 1500);
                        } else {
                            showStatus('✗ 料件不在列表中或庫存為零', 'error');
                            setTimeout(() => {
                                barcodeInput.select();
                                barcodeInput.focus();
                            }, 1500);
                        }
                    }
                } else {
                    showStatus('✗ 未找到對應的料件', 'error');
                    setTimeout(() => {
                        barcodeInput.select();
                        barcodeInput.focus();
                    }, 1500);
                }
            } catch (error) {
                showStatus('✗ 查詢失敗：' + error.message, 'error');
                setTimeout(() => barcodeInput.focus(), 100);
            }
        }
        
        // 查詢按鈕
        if (barcodeLookup) {
            barcodeLookup.addEventListener('click', () => {
                const barcode = barcodeInput.value.trim();
                if (barcode) {
                    lookupBarcode(barcode);
                } else {
                    showStatus('請先輸入或掃描條碼', 'error');
                }
            });
            
            // 條碼輸入框按 Enter 時自動查詢
            barcodeInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    lookupBarcode(barcodeInput.value.trim());
                }
            });
            
            // 清除按鈕
            barcodeClear.addEventListener('click', () => {
                // 清空條碼輸入框
                barcodeInput.value = '';
                // 清除狀態顯示
                if (barcodeStatus) {
                    barcodeStatus.style.display = 'none';
                    barcodeStatus.textContent = '';
                }
                // 重置料件選擇
                if (partSelect) {
                    partSelect.value = '';
                    partSelect.dispatchEvent(new Event('change'));
                }
                // 重置數量輸入
                if (quantityInput) {
                    quantityInput.value = '';
                }
                // 清除借測相關區塊
                if (loanFields) {
                    loanFields.style.display = 'none';
                }
                if (isLoanCheckbox) {
                    isLoanCheckbox.checked = false;
                }
                if (loanDueDate) {
                    loanDueDate.value = '';
                    loanDueDate.required = false;
                }
                // 重新聚焦到條碼輸入框
                barcodeInput.focus();
            });
        }
        
        // 顯示狀態訊息
        function showStatus(message, type) {
            if (!barcodeStatus) return;
            barcodeStatus.textContent = message;
            barcodeStatus.style.display = 'block';
            barcodeStatus.className = '';
            if (type === 'success') {
                barcodeStatus.style.backgroundColor = '#d4edda';
                barcodeStatus.style.color = '#155724';
                barcodeStatus.style.borderLeft = '4px solid #28a745';
            } else if (type === 'error') {
                barcodeStatus.style.backgroundColor = '#f8d7da';
                barcodeStatus.style.color = '#721c24';
                barcodeStatus.style.borderLeft = '4px solid #dc3545';
            } else {
                barcodeStatus.style.backgroundColor = '#d1ecf1';
                barcodeStatus.style.color = '#0c5460';
                barcodeStatus.style.borderLeft = '4px solid #17a2b8';
            }
        }
        
        // 初始化：確保條碼輸入框聚焦（支援無線掃描器）
        function ensureBarcodeFocus() {
            if (barcodeInput) {
                barcodeInput.focus();
                // 將輸入框滾動到可視區域
                barcodeInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }
        
        // 頁面加載完成後立即聚焦
        ensureBarcodeFocus();
        
        // DOM 完全加載後再次聚焦（確保其他腳本不會影響）
        setTimeout(ensureBarcodeFocus, 500);
        
        // 當用戶點擊頁面其他地方後，如果沒有選中任何輸入框，自動回到條碼輸入框
        document.addEventListener('click', (e) => {
            // 如果點擊的不是輸入框、按鈕或連結，則自動聚焦到條碼輸入框
            if (!e.target.matches('input, button, a, select, textarea')) {
                setTimeout(() => barcodeInput.focus(), 50);
            }
        });
    </script>
</body>
</html>

