<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>角色管理 - <%= typeof title !== 'undefined' ? title : '庫存管理系統' %></title>
    <style>
        <%- include('_common-styles') %>

        .stats-summary {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: var(--shadow-sm);
            transition: box-shadow 0.2s, transform 0.15s;
        }

        .stat-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-2px);
        }

        .stat-card-icon {
            width: 46px;
            height: 46px;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .stat-card-icon.purple { background: #ede9fe; }
        .stat-card-icon.blue   { background: #dbeafe; }
        .stat-card-icon.green  { background: #d1fae5; }

        .stat-card-body { flex: 1; }

        .stat-card .stat-value {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-primary);
            line-height: 1.1;
        }

        .stat-card .stat-label {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 3px;
            font-weight: 500;
        }

        .role-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
        }
        .role-badge.system { background: #ede9fe; color: #6d28d9; }
        .role-badge.custom { background: #d1fae5; color: #065f46; }

        .permissions-list { font-size: 13px; color: #666; }

        @media (max-width: 768px) {
            .stats-summary { grid-template-columns: 1fr; gap: 10px; }
            .stat-card { padding: 14px; }
            .stat-card-icon { width: 40px; height: 40px; font-size: 18px; }
            .stat-card .stat-value { font-size: 22px; }
        }
    </style>
</head>
<body>
    <a href="/" class="back-to-home">← 返回主頁</a>
    <%- include('_common-nav') %>
    
    <div class="container">
        <h1>🎭 角色管理</h1>
        
        <div class="stats-summary">
            <div class="stat-card">
                <div class="stat-card-icon purple">🎭</div>
                <div class="stat-card-body">
                    <div class="stat-value"><%= roles ? roles.length : 0 %></div>
                    <div class="stat-label">總角色數</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-icon blue">🔒</div>
                <div class="stat-card-body">
                    <div class="stat-value"><%= roles ? roles.filter(r => r.is_system).length : 0 %></div>
                    <div class="stat-label">系統角色</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-icon green">✨</div>
                <div class="stat-card-body">
                    <div class="stat-value"><%= roles ? roles.filter(r => !r.is_system).length : 0 %></div>
                    <div class="stat-label">自訂角色</div>
                </div>
            </div>
        </div>
        
        <div style="margin-bottom: 20px;">
            <a href="/roles/add" class="btn btn-primary">➕ 新增角色</a>
        </div>
        
        <% if (roles && roles.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>角色名稱</th>
                    <th>顯示名稱</th>
                    <th>說明</th>
                    <th>權限</th>
                    <th>類型</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                <% roles.forEach(function(role) { %>
                <tr>
                    <td><code><%= role.role_name %></code></td>
                    <td><strong><%= role.display_name %></strong></td>
                    <td><%= role.description || '-' %></td>
                    <td>
                        <div class="permissions-list">
                            <% 
                            try {
                                const perms = JSON.parse(role.permissions || '{}');
                                let count = 0;
                                for (let key in perms) {
                                    if (Array.isArray(perms[key])) {
                                        count += perms[key].length;
                                    }
                                }
                            %>
                            <%= count %> 個權限
                            <% } catch(e) { %>
                            -
                            <% } %>
                        </div>
                    </td>
                    <td>
                        <% if (role.is_system) { %>
                        <span class="role-badge system">系統角色</span>
                        <% } else { %>
                        <span class="role-badge custom">自訂角色</span>
                        <% } %>
                    </td>
                    <td class="action-cell">
                        <a href="/roles/edit/<%= role.id %>" class="btn btn-primary">✏️ 編輯</a>
                        <% if (!role.is_system) { %>
                        <form method="POST" action="/roles/delete/<%= role.id %>" style="display: inline;" onsubmit="return confirm('確定要刪除此角色嗎？');">
                            <button type="submit" class="btn btn-danger">🗑️ 刪除</button>
                        </form>
                        <% } %>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        <% } else { %>
        <div class="empty-state">
            <p>目前沒有角色資料</p>
        </div>
        <% } %>
    </div>
    
    <%- include('_common-nav-script') %>
</body>
</html>
