<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>新增用戶 - <%= typeof title !== 'undefined' ? title : '庫存管理系統' %></title>
    <style>
        <%- include('_common-styles') %>
        
        .form-group {
            margin-bottom: 20px;
        }
        
        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #555;
            font-size: 14px;
        }
        
        input[type="text"],
        input[type="number"],
        input[type="date"],
        input[type="password"],
        input[type="email"],
        select,
        textarea {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 6px;
            font-size: 14px;
            transition: all 0.3s;
            font-family: inherit;
        }
        
        input:focus,
        select:focus,
        textarea:focus {
            outline: none;
            border-color: #1e293b;
            box-shadow: 0 0 0 3px rgba(30, 41, 59, 0.1);
        }
        
        button {
            background: #1e293b;
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(30, 41, 59, 0.4);
        }
        
        .flash-messages {
            margin-bottom: 20px;
        }
        
        .flash {
            padding: 15px 20px;
            border-radius: 6px;
            margin-bottom: 10px;
            font-weight: 500;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        
        .flash.success {
            background-color: #d4edda;
            color: #155724;
            border-left: 4px solid #28a745;
        }
        
        .flash.error {
            background-color: #f8d7da;
            color: #721c24;
            border-left: 4px solid #dc3545;
        }
        
        @media (max-width: 768px) {
            .nav-wrapper {
                flex-direction: column;
                align-items: stretch;
            }
            
            nav a {
                width: 100%;
                text-align: center;
                margin-bottom: 5px;
            }
            
            nav .auth-link {
                margin-left: 0;
            }
            
            .container {
                padding: 15px;
            }
            
            /* 表單手機版優化 */
            input[type="text"],
            input[type="email"],
            input[type="password"],
            select {
                font-size: 16px !important;
                padding: 14px !important;
                -webkit-appearance: none;
            }
            
            button {
                width: 100% !important;
                min-height: 48px !important;
                font-size: 16px !important;
                padding: 14px 20px !important;
            }
        }
    </style>
</head>
<body>
    <a href="/" class="back-to-home">← 返回主頁</a>
    <%- include('_common-nav') %>
    
    <div class="container">
        <% if (messages && messages.length > 0) { %>
            <div class="flash-messages">
                <% messages.forEach(function(msg) { %>
                    <div class="flash <%= msg.category %>"><%= msg.message %></div>
                <% }); %>
            </div>
        <% } %>
        
        <h1>➕ 新增用戶</h1>

        <form method="POST">
            <div class="form-group">
                <label for="username">帳號 *</label>
                <input type="text" id="username" name="username" required placeholder="請輸入帳號">
            </div>
            
            <div class="form-group">
                <label for="password">密碼 *</label>
                <input type="password" id="password" name="password" required placeholder="請輸入密碼">
            </div>
            
            <div class="form-group">
                <label for="full_name">姓名</label>
                <input type="text" id="full_name" name="full_name" placeholder="請輸入姓名（選填）">
            </div>
            
            <div class="form-group">
                <label for="email">電子郵件<% if (typeof ssoEnabled !== 'undefined' && ssoEnabled) { %>（M365 登入信箱）<% } %></label>
                <input type="email" id="email" name="email" placeholder="請輸入電子郵件（選填）">
                <% if (typeof ssoEnabled !== 'undefined' && ssoEnabled) { %>
                <small style="display:block; margin-top:4px; color:#1e293b; font-size:12px;">
                    🔑 若要讓此使用者用 Microsoft 365 登入，請填入其 M365 信箱（需與登入帳號完全一致）。
                </small>
                <% } %>
            </div>
            
            <div class="form-group">
                <label for="role">角色 *</label>
                <select id="role" name="role" required>
                    <% if (roles && roles.length > 0) { %>
                        <% roles.forEach(function(role) { %>
                        <option value="<%= role.role_name %>">
                            <%= role.display_name %> 
                            <% if (role.is_system) { %>(系統)<% } %>
                        </option>
                        <% }); %>
                    <% } else { %>
                        <option value="user">一般使用者</option>
                        <option value="admin">管理員</option>
                    <% } %>
                </select>
            </div>
            
            <div class="form-group" style="background:#fff8e1; border:1px solid #ffe082; border-radius:8px; padding:14px 16px; display:flex; align-items:flex-start; gap:12px;">
                <input type="checkbox" id="force_password_change" name="force_password_change" style="width:18px; height:18px; margin-top:2px; flex-shrink:0; cursor:pointer;">
                <div>
                    <label for="force_password_change" style="margin-bottom:4px; cursor:pointer; color:#795548;">🔑 要求首次登入時立即變更密碼</label>
                    <div style="font-size:12px; color:#8d6e63; line-height:1.5;">勾選後，該用戶首次登入時系統將強制要求其立即變更密碼，才能繼續使用系統。</div>
                </div>
            </div>
            
            <button type="submit">新增用戶</button>
            <a href="/users" style="margin-left: 10px; color: #666; text-decoration: none;">取消</a>
        </form>
    </div>
</body>
</html>

