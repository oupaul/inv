<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>借出中料件 - <%= typeof title !== 'undefined' ? title : '庫存管理系統' %></title>
    <style>
        <%- include('_common-styles') %>

        /* 統計卡片 */
        .loan-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .loan-stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: var(--shadow-sm);
        }

        .loan-stat-icon {
            width: 46px;
            height: 46px;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .loan-stat-icon.blue   { background: #dbeafe; }
        .loan-stat-icon.amber  { background: #fef3c7; }
        .loan-stat-icon.green  { background: #d1fae5; }
        .loan-stat-icon.red    { background: #fee2e2; }

        .loan-stat-body { flex: 1; min-width: 0; }

        .loan-stat-value {
            font-size: 24px;
            font-weight: 800;
            color: var(--text-primary);
            line-height: 1.1;
        }

        .loan-stat-label {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 3px;
            font-weight: 500;
        }

        /* 狀態 badge */
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
        }
        .status-badge.pending  { background: #fff3cd; color: #856404; }
        .status-badge.partial  { background: #d1ecf1; color: #0c5460; }

        .quantity-loaned   { color: #1e293b; font-weight: bold; }
        .quantity-returned { color: #28a745; }
        .quantity-remaining{ color: #dc3545; font-weight: bold; }

        .due-status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
        }
        .due-status-badge.overdue  { background: #f8d7da; color: #721c24; animation: pulse 2s infinite; }
        .due-status-badge.due-today{ background: #fff3cd; color: #856404; animation: pulse 2s infinite; }
        .due-status-badge.due-soon { background: #ffeaa7; color: #856404; }
        .due-status-badge.normal   { background: #d4edda; color: #155724; }
        .due-status-badge.no-date  { background: #e9ecef; color: #6c757d; }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        @media (max-width: 768px) {
            .loan-stats { grid-template-columns: repeat(2, 1fr); gap: 10px; }
            .loan-stat-card { padding: 14px; gap: 10px; }
            .loan-stat-icon { width: 38px; height: 38px; font-size: 18px; }
            .loan-stat-value { font-size: 20px; }
        }
    </style>
</head>
<body>
    <a href="/" class="back-to-home">← 返回主頁</a>
    <%- include('_common-nav') %>
    
    <div class="container">
        <% if (messages && messages.length > 0) { %>
            <div class="flash-messages">
                <% messages.forEach(function(msg) { %>
                    <div class="flash <%= msg.category %>"><%= msg.message %></div>
                <% }); %>
            </div>
        <% } %>
        
        <h1>📋 借出中料件</h1>

        <%
            let totalLoaned = 0, totalReturned = 0, totalRemaining = 0;
            if (records) {
                records.forEach(function(r) {
                    totalLoaned   += r.loaned_quantity    || 0;
                    totalReturned += r.returned_quantity  || 0;
                    totalRemaining+= r.remaining_quantity || 0;
                });
            }
        %>
        <div class="loan-stats">
            <div class="loan-stat-card">
                <div class="loan-stat-icon blue">📋</div>
                <div class="loan-stat-body">
                    <div class="loan-stat-value"><%= records ? records.length : 0 %></div>
                    <div class="loan-stat-label">借出筆數</div>
                </div>
            </div>
            <div class="loan-stat-card">
                <div class="loan-stat-icon amber">📤</div>
                <div class="loan-stat-body">
                    <div class="loan-stat-value"><%= totalLoaned %></div>
                    <div class="loan-stat-label">總借出數量</div>
                </div>
            </div>
            <div class="loan-stat-card">
                <div class="loan-stat-icon green">✅</div>
                <div class="loan-stat-body">
                    <div class="loan-stat-value"><%= totalReturned %></div>
                    <div class="loan-stat-label">已歸還數量</div>
                </div>
            </div>
            <div class="loan-stat-card">
                <div class="loan-stat-icon red">⏳</div>
                <div class="loan-stat-body">
                    <div class="loan-stat-value"><%= totalRemaining %></div>
                    <div class="loan-stat-label">未歸還數量</div>
                </div>
            </div>
        </div>

        <% if (records && records.length > 0) { %>

        <div class="mobile-scroll-hint" style="display: none; background: #fff3cd; padding: 10px; border-radius: 6px; margin-bottom: 10px; text-align: center; color: #856404; font-size: 13px; font-weight: 600;">
            ⬅️ 表格可左右滑動查看完整內容 ➡️
        </div>
        <table>
            <thead>
                <tr>
                    <th>借出日期</th>
                    <th>到期日期</th>
                    <th>到期狀態</th>
                    <th>料號</th>
                    <th>料件名稱</th>
                    <th>類型</th>
                    <th>規格</th>
                    <th>條碼</th>
                    <th>借出數量</th>
                    <th>已歸還</th>
                    <th>未歸還</th>
                    <th>單位</th>
                    <th>狀態</th>
                    <th>備註</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                <% records.forEach(function(record) { %>
                <tr>
                    <td><%= record.loan_date %></td>
                    <td>
                        <% if (record.loan_due_date) { %>
                            <%= record.loan_due_date %>
                            <% if (record.days_until_due !== null) { %>
                                <% if (record.days_until_due < 0) { %>
                                    <br><small style="color: #dc3545;">（已過期 <%= Math.abs(Math.floor(record.days_until_due)) %> 天）</small>
                                <% } else if (record.days_until_due === 0) { %>
                                    <br><small style="color: #856404;">（今日到期）</small>
                                <% } else if (record.days_until_due <= 3) { %>
                                    <br><small style="color: #856404;">（剩餘 <%= Math.floor(record.days_until_due) %> 天）</small>
                                <% } %>
                            <% } %>
                        <% } else { %>
                            <span style="color: #999;">未設定</span>
                        <% } %>
                    </td>
                    <td>
                        <% if (record.due_status === '已過期') { %>
                            <span class="due-status-badge overdue">⚠️ 已過期</span>
                        <% } else if (record.due_status === '今日到期') { %>
                            <span class="due-status-badge due-today">⚠️ 今日到期</span>
                        <% } else if (record.due_status === '即將到期') { %>
                            <span class="due-status-badge due-soon">⏰ 即將到期</span>
                        <% } else if (record.due_status === '正常') { %>
                            <span class="due-status-badge normal">✓ 正常</span>
                        <% } else { %>
                            <span class="due-status-badge no-date">- 無到期日期</span>
                        <% } %>
                    </td>
                    <td><%= record.part_number %></td>
                    <td><%= record.part_name %></td>
                    <td><%= record.category_name || '-' %></td>
                    <td><%= record.specification || '-' %></td>
                    <td><%= record.barcode || '-' %></td>
                    <td>
                        <div class="quantity-info">
                            <span class="quantity-loaned"><%= record.loaned_quantity %></span>
                        </div>
                    </td>
                    <td>
                        <div class="quantity-info">
                            <span class="quantity-returned"><%= record.returned_quantity %></span>
                        </div>
                    </td>
                    <td>
                        <div class="quantity-info">
                            <span class="quantity-remaining"><%= record.remaining_quantity %></span>
                        </div>
                    </td>
                    <td><%= record.unit %></td>
                    <td>
                        <% if (record.returned_quantity === 0) { %>
                            <span class="status-badge pending">未歸還</span>
                        <% } else { %>
                            <span class="status-badge partial">部分歸還</span>
                        <% } %>
                    </td>
                    <td><%= record.loan_note || '-' %></td>
                    <td>
                        <button class="btn-convert-outbound" 
                                data-id="<%= record.id %>" 
                                data-part-name="<%= record.part_name %>"
                                data-remaining="<%= record.remaining_quantity %>"
                                style="background-color: #1e293b; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 500; transition: all 0.3s;">
                            📤 轉出貨
                        </button>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        <% } else { %>
        <div class="empty-state">
            <p>目前沒有任何借出中的料件</p>
            <p>所有借測記錄都已歸還</p>
        </div>
        <% } %>
    </div>
    <script>
        <%- include('_common-mobile-script') %>
    </script>
    <%- include('_common-nav-script') %>
    
    <script>
        // 轉出貨功能
        document.addEventListener('DOMContentLoaded', function() {
            const convertButtons = document.querySelectorAll('.btn-convert-outbound');
            
            convertButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const recordId = this.getAttribute('data-id');
                    const partName = this.getAttribute('data-part-name');
                    const remaining = this.getAttribute('data-remaining');
                    
                    if (!confirm('確定要將此借測記錄轉為正常出貨嗎？\n\n料件：' + partName + '\n未歸還數量：' + remaining + '\n\n轉換後，此記錄將不再視為借測，會影響庫存計算。')) {
                        return;
                    }
                    
                    // 禁用按鈕，防止重複點擊
                    this.disabled = true;
                    const originalText = this.textContent;
                    this.textContent = '處理中...';
                    
                    // 發送轉換請求
                    fetch('/api/loans/convert-to-outbound/' + recordId, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    })
                    .then(function(res) {
                        if (!res.ok) {
                            throw new Error('HTTP error! status: ' + res.status);
                        }
                        return res.json();
                    })
                    .then(function(data) {
                        if (data.success) {
                            alert('轉換成功！');
                            location.reload();
                        } else {
                            alert('轉換失敗：' + (data.error || '未知錯誤'));
                            button.disabled = false;
                            button.textContent = originalText;
                        }
                    })
                    .catch(function(err) {
                        console.error('轉換錯誤:', err);
                        alert('轉換時發生錯誤，請稍後再試');
                        button.disabled = false;
                        button.textContent = originalText;
                    });
                });
            });
        });
    </script>
</body>
</html>

