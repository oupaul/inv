<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>系統健康狀態 - <%= typeof title !== 'undefined' ? title : '庫存管理系統' %></title>
    <style>
        <%- include('_common-styles') %>
        .health-section {
            margin-bottom: 30px;
            padding: 20px;
            background-color: #f8f9fa;
            border-radius: 8px;
            border-left: 4px solid #667eea;
        }
        
        .health-section h2 {
            margin-top: 0;
            margin-bottom: 15px;
            color: #333;
            font-size: 20px;
        }
        
        .health-item {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #e0e0e0;
        }
        
        .health-item:last-child {
            border-bottom: none;
        }
        
        .health-label {
            font-weight: 600;
            color: #555;
        }
        
        .health-value {
            color: #333;
            font-family: monospace;
        }
        
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
        }
        
        .status-badge.healthy {
            background-color: #d4edda;
            color: #155724;
        }
        
        .status-badge.warning {
            background-color: #fff3cd;
            color: #856404;
        }
        
        .status-badge.error {
            background-color: #f8d7da;
            color: #721c24;
        }
        
        .health-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        
        .health-card {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        
        .health-card h3 {
            margin-top: 0;
            margin-bottom: 15px;
            color: #667eea;
            font-size: 16px;
        }
        
        .refresh-btn {
            background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 20px;
        }
        
        .refresh-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0, 123, 255, 0.4);
        }
        
        .table-counts {
            margin-top: 15px;
        }
        
        .table-count-item {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #e0e0e0;
        }
        
        .table-count-item:last-child {
            border-bottom: none;
        }
        
        .progress-bar {
            height: 20px;
            background-color: #e0e0e0;
            border-radius: 10px;
            overflow: hidden;
            margin-top: 5px;
        }
        
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #28a745 0%, #20c997 100%);
            transition: width 0.3s;
        }
        
        .progress-fill.warning {
            background: linear-gradient(90deg, #ffc107 0%, #ff9800 100%);
        }
        
        .progress-fill.danger {
            background: linear-gradient(90deg, #dc3545 0%, #c82333 100%);
        }
        
        .btn-small {
            padding: 6px 12px;
            font-size: 13px;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            font-weight: 500;
            transition: all 0.3s;
            color: white;
        }
        
        .btn-small:hover {
            transform: translateY(-2px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }
        
        .form-group {
            margin-bottom: 15px;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #333;
        }
        
        .form-group input[type="number"] {
            width: 100%;
            padding: 10px;
            border: 2px solid #ddd;
            border-radius: 6px;
            font-size: 15px;
            transition: border-color 0.3s;
        }
        
        .form-group input[type="number"]:focus {
            outline: none;
            border-color: #667eea;
        }
    </style>
</head>
<body>
    <a href="/" class="back-to-home">← 返回主頁</a>
    <%- include('_common-nav') %>
    
    <div class="container">
        <% if (messages && messages.length > 0) { %>
            <div class="flash-messages">
                <% messages.forEach(function(msg) { %>
                    <div class="flash <%= msg.category %>"><%= msg.message %></div>
                <% }); %>
            </div>
        <% } %>
        
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h1>🏥 系統健康狀態</h1>
            <button class="refresh-btn" onclick="location.reload()">🔄 刷新</button>
        </div>
        
        <div class="health-grid">
            <!-- 系統資訊 -->
            <div class="health-card">
                <h3>💻 系統資訊</h3>
                <div class="health-item">
                    <span class="health-label">節點版本</span>
                    <span class="health-value"><%= health.system.nodeVersion %></span>
                </div>
                <div class="health-item">
                    <span class="health-label">作業系統</span>
                    <span class="health-value"><%= health.system.platform %> (<%= health.system.arch %>)</span>
                </div>
                <div class="health-item">
                    <span class="health-label">運行時間</span>
                    <span class="health-value">
                        <% 
                        const uptime = health.system.uptime;
                        const days = Math.floor(uptime / 86400);
                        const hours = Math.floor((uptime % 86400) / 3600);
                        const minutes = Math.floor((uptime % 3600) / 60);
                        %>
                        <%= days %> 天 <%= hours %> 小時 <%= minutes %> 分鐘
                    </span>
                </div>
            </div>
            
            <!-- 記憶體使用 -->
            <div class="health-card">
                <h3>🧠 記憶體使用</h3>
                <div class="health-item">
                    <span class="health-label">堆積記憶體</span>
                    <span class="health-value"><%= health.system.memory.used %> MB / <%= health.system.memory.total %> MB</span>
                </div>
                <div class="health-item">
                    <span class="health-label">RSS 記憶體</span>
                    <span class="health-value"><%= health.system.memory.rss %> MB</span>
                </div>
                <div class="health-item">
                    <span class="health-label">使用率</span>
                    <span class="health-value">
                        <% 
                        const memoryPercent = ((health.system.memory.used / health.system.memory.total) * 100).toFixed(1);
                        const memoryClass = memoryPercent > 80 ? 'danger' : memoryPercent > 60 ? 'warning' : '';
                        %>
                        <div>
                            <%= memoryPercent %>%
                            <div class="progress-bar">
                                <div class="progress-fill <%= memoryClass %>" style="width: <%= memoryPercent %>%"></div>
                            </div>
                        </div>
                    </span>
                </div>
            </div>
            
            <!-- 資料庫狀態 -->
            <div class="health-card">
                <h3>🗄️ 資料庫狀態</h3>
                <div class="health-item">
                    <span class="health-label">連接狀態</span>
                    <span class="health-value">
                        <% if (health.database.status === 'healthy') { %>
                            <span class="status-badge healthy">✓ 正常</span>
                        <% } else if (health.database.status === 'error') { %>
                            <span class="status-badge error">✗ 錯誤</span>
                        <% } else { %>
                            <span class="status-badge warning">⚠ 未知</span>
                        <% } %>
                    </span>
                </div>
                <div class="health-item">
                    <span class="health-label">資料庫大小</span>
                    <span class="health-value">
                        <% 
                        let dbSizeText = '';
                        if (health.database.size < 1024) {
                            dbSizeText = health.database.size + ' KB';
                        } else {
                            dbSizeText = (health.database.size / 1024).toFixed(2) + ' MB';
                        }
                        %>
                        <%= dbSizeText %>
                    </span>
                </div>
                <div class="health-item">
                    <span class="health-label">資料表數量</span>
                    <span class="health-value"><%= health.database.tables ? health.database.tables.length : 0 %> 個</span>
                </div>
                <% if (health.database.error) { %>
                <div class="health-item">
                    <span class="health-label">錯誤訊息</span>
                    <span class="health-value" style="color: #dc3545;"><%= health.database.error %></span>
                </div>
                <% } %>
            </div>
            
            <!-- 磁碟空間 -->
            <% if (health.disk && health.disk.total > 0) { %>
            <div class="health-card">
                <h3>💿 磁碟空間</h3>
                <div class="health-item">
                    <span class="health-label">總容量</span>
                    <span class="health-value"><%= (health.disk.total / 1024).toFixed(2) %> GB</span>
                </div>
                <div class="health-item">
                    <span class="health-label">可用空間</span>
                    <span class="health-value"><%= (health.disk.free / 1024).toFixed(2) %> GB</span>
                </div>
                <div class="health-item">
                    <span class="health-label">使用率</span>
                    <span class="health-value">
                        <% 
                        const diskUsed = health.disk.total - health.disk.free;
                        const diskPercent = ((diskUsed / health.disk.total) * 100).toFixed(1);
                        const diskClass = diskPercent > 90 ? 'danger' : diskPercent > 75 ? 'warning' : '';
                        %>
                        <div>
                            <%= diskPercent %>%
                            <div class="progress-bar">
                                <div class="progress-fill <%= diskClass %>" style="width: <%= diskPercent %>%"></div>
                            </div>
                        </div>
                    </span>
                </div>
            </div>
            <% } %>
        </div>
        
        <!-- 系統設定 -->
        <div class="health-section">
            <h2>⚙️ 系統設定</h2>
            <div class="table-counts">
                <div class="table-count-item">
                    <span class="health-label">強制登出時間</span>
                    <span class="health-value">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span id="forceLogoutDisplay">
                                <%= typeof forceLogoutMinutes !== 'undefined' ? forceLogoutMinutes : 480 %> 分鐘 
                                (<%= typeof forceLogoutMinutes !== 'undefined' ? (forceLogoutMinutes / 60).toFixed(1) : 8 %> 小時)
                            </span>
                            <button type="button" class="btn-small btn-download" onclick="showForceLogoutModal()" style="background-color: #28a745;">✏️ 修改</button>
                        </div>
                    </span>
                </div>
            </div>
        </div>
        
        <!-- 資料表記錄統計 -->
        <% if (health.database.tables && health.database.tables.length > 0) { %>
        <div class="health-section">
            <h2>📊 資料表記錄統計</h2>
            <div class="table-counts">
                <% health.database.tables.forEach(function(tableName) { %>
                <div class="table-count-item">
                    <span class="health-label"><%= tableName %></span>
                    <span class="health-value"><%= health.database.recordCounts[tableName] || 0 %> 筆記錄</span>
                </div>
                <% }); %>
            </div>
        </div>
        <% } %>
        
        <!-- 檢查時間 -->
        <div style="text-align: center; margin-top: 30px; color: #999; font-size: 13px;">
            最後檢查時間：<%= new Date(health.timestamp).toLocaleString('zh-TW') %>
        </div>
    </div>
    
    <!-- 強制登出時間設定模態框 -->
    <div id="forceLogoutModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
        <div style="background: white; padding: 30px; border-radius: 12px; max-width: 500px; width: 90%; max-height: 90vh; overflow-y: auto;">
            <h2 style="margin-top: 0;">⏰ 設定強制登出時間</h2>
            <div class="form-group">
                <label for="forceLogoutMinutes">登出時間（分鐘）</label>
                <input type="number" id="forceLogoutMinutes" min="1" max="10080" value="<%= typeof forceLogoutMinutes !== 'undefined' ? forceLogoutMinutes : 480 %>" required>
                <small style="color: #666; display: block; margin-top: 5px;">
                    請輸入 1 到 10080 之間的數字（10080 分鐘 = 7 天）<br>
                    當前設定：<span id="currentMinutesDisplay"><%= typeof forceLogoutMinutes !== 'undefined' ? forceLogoutMinutes : 480 %></span> 分鐘 
                    (<span id="currentHoursDisplay"><%= typeof forceLogoutMinutes !== 'undefined' ? (forceLogoutMinutes / 60).toFixed(1) : 8 %></span> 小時)
                </small>
            </div>
            <div style="margin-top: 20px; display: flex; gap: 10px;">
                <button type="button" class="btn btn-primary" onclick="saveForceLogoutSetting()">💾 保存設定</button>
                <button type="button" class="btn btn-secondary" onclick="closeForceLogoutModal()">取消</button>
            </div>
            <div style="margin-top: 20px; padding: 15px; background: #f8f9fa; border-radius: 6px; font-size: 13px; color: #666;">
                <strong>📝 說明：</strong><br>
                設定使用者登入後多少分鐘會被強制登出。系統會自動檢查所有使用者的登入時間，超過設定時間的使用者將被自動登出。
            </div>
        </div>
    </div>
    
    <script>
        // 自動刷新（每30秒）
        setTimeout(function() {
            location.reload();
        }, 30000);
        
        // 強制登出時間設定
        function showForceLogoutModal() {
            document.getElementById('forceLogoutModal').style.display = 'flex';
            // 載入當前設定
            fetch('/api/settings/force-logout')
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('forceLogoutMinutes').value = data.forceLogoutMinutes;
                        updateMinutesDisplay(data.forceLogoutMinutes);
                    }
                })
                .catch(err => console.error('載入設定失敗:', err));
        }
        
        function closeForceLogoutModal() {
            document.getElementById('forceLogoutModal').style.display = 'none';
        }
        
        function updateMinutesDisplay(minutes) {
            const hours = (minutes / 60).toFixed(1);
            document.getElementById('currentMinutesDisplay').textContent = minutes;
            document.getElementById('currentHoursDisplay').textContent = hours;
        }
        
        document.getElementById('forceLogoutMinutes')?.addEventListener('input', function(e) {
            const minutes = parseInt(e.target.value);
            if (!isNaN(minutes) && minutes >= 1 && minutes <= 10080) {
                updateMinutesDisplay(minutes);
            }
        });
        
        function saveForceLogoutSetting() {
            const minutes = parseInt(document.getElementById('forceLogoutMinutes').value);
            
            if (isNaN(minutes) || minutes < 1 || minutes > 10080) {
                alert('請輸入 1 到 10080 之間的有效數字');
                return;
            }
            
            fetch('/api/settings/force-logout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ minutes: minutes })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert('設定已保存成功！');
                    // 更新顯示
                    const hours = (minutes / 60).toFixed(1);
                    document.getElementById('forceLogoutDisplay').textContent = minutes + ' 分鐘 (' + hours + ' 小時)';
                    closeForceLogoutModal();
                    // 重新載入頁面以更新顯示
                    setTimeout(() => location.reload(), 500);
                } else {
                    alert('保存失敗：' + (data.error || '未知錯誤'));
                }
            })
            .catch(err => {
                console.error('保存設定失敗:', err);
                alert('保存設定時發生錯誤，請稍後再試');
            });
        }
        
        // 點擊模態框外部關閉
        document.getElementById('forceLogoutModal')?.addEventListener('click', function(e) {
            if (e.target === this) closeForceLogoutModal();
        });
    </script>
</body>
</html>

