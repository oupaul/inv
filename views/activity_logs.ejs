<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>操作記錄 - <%= typeof title !== 'undefined' ? title : '庫存管理系統' %></title>
    <style>
        <%- include('_common-styles') %>

        .stats-summary {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: var(--shadow-sm);
            transition: box-shadow 0.2s, transform 0.15s;
        }

        .stat-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-2px);
        }

        .stat-card-icon {
            width: 46px;
            height: 46px;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .stat-card-icon.purple { background: #ede9fe; }
        .stat-card-icon.blue   { background: #dbeafe; }
        .stat-card-icon.green  { background: #d1fae5; }

        .stat-card-body { flex: 1; }

        .stat-card .stat-value {
            font-size: 26px;
            font-weight: 800;
            color: var(--text-primary);
            line-height: 1.1;
        }

        .stat-card .stat-label {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 3px;
            font-weight: 500;
        }

        .action-type-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 600;
        }
        .action-type-badge.login  { background: #cffafe; color: #0e7490; }
        .action-type-badge.create { background: #d1fae5; color: #065f46; }
        .action-type-badge.update { background: #fef3c7; color: #92400e; }
        .action-type-badge.delete { background: #fee2e2; color: #991b1b; }
        .action-type-badge.view   { background: #f1f5f9; color: #475569; }
        .action-type-badge.other  { background: #ede9fe; color: #6d28d9; }

        .log-detail { font-size: 13px; color: var(--text-muted); }

        @media (max-width: 768px) {
            .stats-summary { grid-template-columns: 1fr; gap: 10px; }
            .stat-card { padding: 14px; }
            .stat-card-icon { width: 40px; height: 40px; font-size: 18px; }
            .stat-card .stat-value { font-size: 22px; }
        }
    </style>
</head>
<body>
    <a href="/" class="back-to-home">← 返回主頁</a>
    <%- include('_common-nav') %>
    
    <div class="container">
        <h1>📋 人員操作記錄</h1>
        
        <%
            const uniqueUsers = logs ? [...new Set(logs.map(l => l.username))].length : 0;
            const todayStr = new Date().toLocaleDateString('zh-TW', { month: 'numeric', day: 'numeric' });
        %>
        <div class="stats-summary">
            <div class="stat-card">
                <div class="stat-card-icon purple">📝</div>
                <div class="stat-card-body">
                    <div class="stat-value"><%= logs ? logs.length : 0 %></div>
                    <div class="stat-label">總記錄數</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-icon blue">👥</div>
                <div class="stat-card-body">
                    <div class="stat-value"><%= uniqueUsers %></div>
                    <div class="stat-label">操作人數</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-icon green">📅</div>
                <div class="stat-card-body">
                    <div class="stat-value" style="font-size:18px; margin-top:2px;"><%= todayStr %></div>
                    <div class="stat-label">今日日期</div>
                </div>
            </div>
        </div>
        
        <!-- 搜尋區域 -->
        <div class="search-section">
            <form method="GET" action="/activity-logs">
                <div style="display: flex; gap: 15px; flex-wrap: wrap; align-items: flex-end;">
                    <div style="flex: 1; min-width: 150px;">
                        <label for="username">使用者</label>
                        <input type="text" id="username" name="username" value="<%= username || '' %>" placeholder="輸入使用者名稱">
                    </div>
                    <div style="flex: 1; min-width: 150px;">
                        <label for="action_type">操作類型</label>
                        <select id="action_type" name="action_type">
                            <option value="">全部類型</option>
                            <option value="login" <%= action_type === 'login' ? 'selected' : '' %>>登入</option>
                            <option value="logout" <%= action_type === 'logout' ? 'selected' : '' %>>登出</option>
                            <option value="create" <%= action_type === 'create' ? 'selected' : '' %>>新增</option>
                            <option value="update" <%= action_type === 'update' ? 'selected' : '' %>>修改</option>
                            <option value="delete" <%= action_type === 'delete' ? 'selected' : '' %>>刪除</option>
                            <option value="inbound" <%= action_type === 'inbound' ? 'selected' : '' %>>入庫</option>
                            <option value="outbound" <%= action_type === 'outbound' ? 'selected' : '' %>>出庫</option>
                            <option value="loan" <%= action_type === 'loan' ? 'selected' : '' %>>借測</option>
                            <option value="return" <%= action_type === 'return' ? 'selected' : '' %>>歸還</option>
                            <option value="export" <%= action_type === 'export' ? 'selected' : '' %>>匯出</option>
                            <option value="import" <%= action_type === 'import' ? 'selected' : '' %>>匯入</option>
                            <option value="backup" <%= action_type === 'backup' ? 'selected' : '' %>>備份</option>
                            <option value="restore" <%= action_type === 'restore' ? 'selected' : '' %>>還原</option>
                            <option value="adjust" <%= action_type === 'adjust' ? 'selected' : '' %>>調整</option>
                        </select>
                    </div>
                    <div style="flex: 1; min-width: 150px;">
                        <label for="date_from">開始日期</label>
                        <input type="date" id="date_from" name="date_from" value="<%= date_from || '' %>">
                    </div>
                    <div style="flex: 1; min-width: 150px;">
                        <label for="date_to">結束日期</label>
                        <input type="date" id="date_to" name="date_to" value="<%= date_to || '' %>">
                    </div>
                    <div style="display: flex; gap: 10px;">
                        <button type="submit" class="btn btn-primary">🔍 搜尋</button>
                        <a href="/activity-logs" class="btn btn-secondary">清除</a>
                    </div>
                </div>
            </form>
        </div>
        
        <% if (logs && logs.length > 0) { %>
        <div class="mobile-scroll-hint" style="display: none; background: #fff3cd; padding: 10px; border-radius: 6px; margin-bottom: 10px; text-align: center; color: #856404; font-size: 13px; font-weight: 600;">
            ⬅️ 表格可左右滑動查看完整內容 ➡️
        </div>
        <table>
            <thead>
                <tr>
                    <th>時間</th>
                    <th>使用者</th>
                    <th>操作類型</th>
                    <th>操作詳情</th>
                    <th>目標類型</th>
                    <th>IP位址</th>
                </tr>
            </thead>
            <tbody>
                <% logs.forEach(function(log) { %>
                <tr>
                    <td><%= new Date(log.created_at).toLocaleString('zh-TW') %></td>
                    <td><strong><%= log.username %></strong></td>
                    <td>
                        <% 
                        let badgeClass = 'other';
                        if (log.action_type === 'login' || log.action_type === 'logout') badgeClass = 'login';
                        else if (log.action_type === 'create') badgeClass = 'create';
                        else if (log.action_type === 'update') badgeClass = 'update';
                        else if (log.action_type === 'delete') badgeClass = 'delete';
                        else if (log.action_type === 'view') badgeClass = 'view';
                        else if (log.action_type === 'inbound' || log.action_type === 'return') badgeClass = 'create';
                        else if (log.action_type === 'outbound' || log.action_type === 'loan') badgeClass = 'update';
                        else if (log.action_type === 'export' || log.action_type === 'import') badgeClass = 'other';
                        else if (log.action_type === 'backup' || log.action_type === 'restore') badgeClass = 'other';
                        else if (log.action_type === 'adjust') badgeClass = 'update';
                        %>
                        <span class="action-type-badge <%= badgeClass %>"><%= log.action_type %></span>
                    </td>
                    <td class="log-detail"><%= log.action_detail || '-' %></td>
                    <td><%= log.target_type || '-' %></td>
                    <td><code><%= log.ip_address || '-' %></code></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        <p style="margin-top: 10px; color: #999; font-size: 14px;">共 <%= logs.length %> 筆記錄</p>
        <% } else { %>
        <div class="empty-state">
            <p>目前沒有操作記錄</p>
            <p>或請調整搜尋條件</p>
        </div>
        <% } %>
    </div>
    
    <%- include('_common-nav-script') %>
</body>
</html>
