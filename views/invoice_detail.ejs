<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - 庫存管理系統</title>
    <style>
        <%- include('_common-styles') %>

        .detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .info-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 18px 20px;
        }

        .info-card-title {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-secondary);
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border);
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            padding: 6px 0;
            font-size: 14px;
            border-bottom: 1px solid #f8fafc;
        }

        .info-row:last-child { border-bottom: none; }
        .info-label { color: var(--text-muted); font-size: 12px; flex-shrink: 0; margin-right: 12px; }
        .info-value { font-weight: 600; color: var(--text-primary); text-align: right; }

        .amount-summary {
            background: linear-gradient(135deg, #eff6ff, #dbeafe);
            border: 1px solid #bfdbfe;
            border-radius: var(--radius-lg);
            padding: 16px 20px;
            display: flex;
            justify-content: flex-end;
            gap: 40px;
            margin-bottom: 20px;
        }

        .amount-item { text-align: right; }
        .amount-item label { font-size: 12px; color: #64748b; display: block; }
        .amount-item .val { font-size: 20px; font-weight: 700; color: #1e40af; }
        .amount-item.grand .val { font-size: 28px; color: #f06000; }

        .status-badge-lg {
            display: inline-block;
            padding: 6px 18px;
            border-radius: 20px;
            font-size: 15px;
            font-weight: 700;
        }

        .badge-paid    { background: #d1fae5; color: #065f46; }
        .badge-partial { background: #dbeafe; color: #1e40af; }
        .badge-unpaid  { background: #fef3c7; color: #92400e; }
        .badge-overdue { background: #fee2e2; color: #991b1b; }

        .item-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px; }
        .item-table th { background: #f8fafc; padding: 9px 12px; text-align: left; border-bottom: 2px solid var(--border); color: var(--text-secondary); font-size: 12px; }
        .item-table td { padding: 10px 12px; border-bottom: 1px solid #f1f5f9; }
        .item-table tr:last-child td { border-bottom: none; }
        .text-right { text-align: right; }

        /* 付款更新 Modal */
        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 999; display: none; align-items: center; justify-content: center; }
        .modal-overlay.open { display: flex; }
        .modal-box { background: #fff; border-radius: 14px; padding: 24px; width: 90%; max-width: 440px; box-shadow: 0 20px 60px rgba(0,0,0,0.2); }
        .modal-title { font-size: 16px; font-weight: 700; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid var(--border); }

        @media (max-width: 768px) {
            .detail-grid { grid-template-columns: 1fr; }
            .amount-summary { flex-direction: column; align-items: flex-end; gap: 12px; }
        }
    </style>
</head>
<body>
    <%- include('_common-nav') %>
    <div class="container">
        <% if (messages && messages.length > 0) { %>
            <div class="flash-messages">
                <% messages.forEach(msg => { %><div class="flash <%= msg.category %>"><%= msg.message %></div><% }); %>
            </div>
        <% } %>

        <%
            const isOverdue = invoice.payment_status !== 'paid' && invoice.payment_due_date && new Date(invoice.payment_due_date) < new Date();
            let badgeClass = 'badge-unpaid', badgeText = '未付款';
            if (invoice.payment_status === 'paid')    { badgeClass = 'badge-paid';    badgeText = '已付清'; }
            else if (invoice.payment_status === 'partial') { badgeClass = 'badge-partial'; badgeText = '部分付款'; }
            else if (isOverdue)                        { badgeClass = 'badge-overdue'; badgeText = '⚠️ 逾期未付'; }
            const methodMap = { transfer:'匯款', cash:'現金', check:'支票' };
        %>

        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:20px;">
            <div style="display:flex; align-items:center; gap:12px;">
                <a href="/invoices" class="btn btn-secondary">← 返回清單</a>
                <h1 style="margin:0;">🧾 <%= invoice.invoice_number %></h1>
                <span class="status-badge-lg <%= badgeClass %>"><%= badgeText %></span>
            </div>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <% if (invoice.payment_status !== 'paid') { %>
                <button class="btn btn-primary" onclick="openPayModal()">💳 更新付款狀態</button>
                <% } %>
                <a href="/invoices/<%= invoice.id %>/edit" class="btn btn-secondary">✏️ 編輯發票</a>
                <% if (user && user.role === 'admin') { %>
                <form method="POST" action="/invoices/<%= invoice.id %>/delete" onsubmit="return confirm('確定刪除此發票？此操作無法復原！')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-danger">🗑️ 刪除</button>
                </form>
                <% } %>
            </div>
        </div>

        <!-- 金額摘要 -->
        <div class="amount-summary">
            <div class="amount-item">
                <label>未稅金額</label>
                <div class="val">NT$ <%= (invoice.subtotal||0).toLocaleString('zh-TW',{minimumFractionDigits:0}) %></div>
            </div>
            <div class="amount-item">
                <label>稅額（<%= Math.round((invoice.tax_rate||0)*100) %>%）</label>
                <div class="val">NT$ <%= (invoice.tax_amount||0).toLocaleString('zh-TW',{minimumFractionDigits:0}) %></div>
            </div>
            <div class="amount-item grand">
                <label>含稅總額</label>
                <div class="val">NT$ <%= (invoice.total_amount||0).toLocaleString('zh-TW',{minimumFractionDigits:0}) %></div>
            </div>
        </div>

        <!-- 資訊卡片 -->
        <div class="detail-grid">
            <div class="info-card">
                <div class="info-card-title">📋 發票資訊</div>
                <div class="info-row"><span class="info-label">發票號碼</span><span class="info-value"><code><%= invoice.invoice_number %></code></span></div>
                <div class="info-row"><span class="info-label">開立日期</span><span class="info-value"><%= invoice.invoice_date %></span></div>
                <div class="info-row"><span class="info-label">建立者</span><span class="info-value"><%= invoice.created_by || '-' %></span></div>
                <div class="info-row"><span class="info-label">備註</span><span class="info-value"><%= invoice.note || '-' %></span></div>
            </div>
            <div class="info-card">
                <div class="info-card-title">🏢 客戶資訊</div>
                <div class="info-row"><span class="info-label">客戶名稱</span><span class="info-value"><%= invoice.customer_name %></span></div>
                <div class="info-row"><span class="info-label">聯絡人</span><span class="info-value"><%= invoice.customer_contact || '-' %></span></div>
                <div class="info-row"><span class="info-label">聯絡電話</span><span class="info-value"><%= invoice.customer_phone || '-' %></span></div>
                <div class="info-row"><span class="info-label">Email</span><span class="info-value"><%= invoice.customer_email || '-' %></span></div>
            </div>
            <div class="info-card">
                <div class="info-card-title">💳 付款資訊</div>
                <div class="info-row"><span class="info-label">付款狀態</span><span class="info-value"><span class="status-badge-lg <%= badgeClass %>" style="padding:3px 12px; font-size:13px;"><%= badgeText %></span></span></div>
                <div class="info-row"><span class="info-label">付款方式</span><span class="info-value"><%= methodMap[invoice.payment_method] || (invoice.payment_method || '-') %></span></div>
                <div class="info-row">
                    <span class="info-label">付款到期日</span>
                    <span class="info-value" style="color:<%= isOverdue ? '#dc2626' : 'inherit' %>; font-weight:<%= isOverdue ? '700' : '600' %>">
                        <%= invoice.payment_due_date || '-' %><%= isOverdue ? ' ⚠️' : '' %>
                    </span>
                </div>
                <div class="info-row"><span class="info-label">實際付款日</span><span class="info-value"><%= invoice.payment_date || '-' %></span></div>
                <% if (invoice.payment_note) { %>
                <div class="info-row"><span class="info-label">付款備註</span><span class="info-value"><%= invoice.payment_note %></span></div>
                <% } %>
            </div>
        </div>

        <!-- 發票明細 -->
        <div class="info-card" style="margin-bottom:20px;">
            <div class="info-card-title">📝 發票明細（<%= items.length %> 項）</div>
            <% if (items && items.length > 0) { %>
            <table class="item-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>料號</th>
                        <th>品名</th>
                        <th>規格</th>
                        <th>單位</th>
                        <th class="text-right">數量</th>
                        <th class="text-right">單價</th>
                        <th class="text-right">小計</th>
                    </tr>
                </thead>
                <tbody>
                    <% items.forEach(function(item, i) { %>
                    <tr>
                        <td style="color:#999;"><%= i+1 %></td>
                        <td><code style="font-size:12px; color:#666;"><%= item.part_number || '-' %></code></td>
                        <td style="font-weight:600;"><%= item.part_name %></td>
                        <td style="font-size:12px; color:#666;"><%= item.specification || '-' %></td>
                        <td style="font-size:12px; color:#666;"><%= item.unit || '-' %></td>
                        <td class="text-right"><%= item.quantity %></td>
                        <td class="text-right" style="color:#555;">NT$ <%= (item.unit_price||0).toLocaleString('zh-TW',{minimumFractionDigits:0}) %></td>
                        <td class="text-right" style="font-weight:700; color:#1e40af;">NT$ <%= (item.subtotal||0).toLocaleString('zh-TW',{minimumFractionDigits:0}) %></td>
                    </tr>
                    <% }); %>
                </tbody>
                <tfoot>
                    <tr style="background:#f8fafc; font-size:13px;">
                        <td colspan="7" style="text-align:right; padding:10px 12px; color:#64748b;">未稅合計</td>
                        <td class="text-right" style="padding:10px 12px; font-weight:700;">NT$ <%= (invoice.subtotal||0).toLocaleString('zh-TW',{minimumFractionDigits:0}) %></td>
                    </tr>
                    <tr style="background:#f8fafc; font-size:13px;">
                        <td colspan="7" style="text-align:right; padding:4px 12px; color:#64748b;">稅額（<%= Math.round((invoice.tax_rate||0)*100) %>%）</td>
                        <td class="text-right" style="padding:4px 12px; font-weight:700; color:#64748b;">NT$ <%= (invoice.tax_amount||0).toLocaleString('zh-TW',{minimumFractionDigits:0}) %></td>
                    </tr>
                    <tr style="background:#eff6ff;">
                        <td colspan="7" style="text-align:right; padding:12px; font-weight:700; color:#f06000; font-size:15px;">含稅總額</td>
                        <td class="text-right" style="padding:12px; font-weight:800; color:#f06000; font-size:18px;">NT$ <%= (invoice.total_amount||0).toLocaleString('zh-TW',{minimumFractionDigits:0}) %></td>
                    </tr>
                </tfoot>
            </table>
            <% } else { %>
            <p style="color:#999; text-align:center; padding:16px;">無明細資料</p>
            <% } %>
        </div>
    </div>

    <!-- 付款更新 Modal -->
    <div class="modal-overlay" id="payModal">
        <div class="modal-box">
            <div class="modal-title">💳 更新付款狀態</div>
            <form method="POST" action="/invoices/<%= invoice.id %>/payment">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <label>付款狀態</label>
                    <select name="payment_status" required>
                        <option value="unpaid"  <%= invoice.payment_status === 'unpaid'  ? 'selected' : '' %>>未付款</option>
                        <option value="partial" <%= invoice.payment_status === 'partial' ? 'selected' : '' %>>部分付款</option>
                        <option value="paid"    <%= invoice.payment_status === 'paid'    ? 'selected' : '' %>>已付清</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>付款日期</label>
                    <input type="date" name="payment_date" value="<%= invoice.payment_date || new Date().toISOString().split('T')[0] %>">
                </div>
                <div class="form-group">
                    <label>付款方式</label>
                    <select name="payment_method">
                        <option value="">請選擇</option>
                        <option value="transfer" <%= invoice.payment_method === 'transfer' ? 'selected' : '' %>>匯款</option>
                        <option value="cash"     <%= invoice.payment_method === 'cash'     ? 'selected' : '' %>>現金</option>
                        <option value="check"    <%= invoice.payment_method === 'check'    ? 'selected' : '' %>>支票</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>付款備註</label>
                    <input type="text" name="payment_note" value="<%= invoice.payment_note || '' %>" placeholder="匯款帳號末4碼、支票號碼等">
                </div>
                <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:16px;">
                    <button type="button" class="btn btn-secondary" onclick="closePayModal()">取消</button>
                    <button type="submit" class="btn btn-primary">✅ 確認更新</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openPayModal()  { document.getElementById('payModal').classList.add('open'); }
        function closePayModal() { document.getElementById('payModal').classList.remove('open'); }
        document.getElementById('payModal').addEventListener('click', function(e) {
            if (e.target === this) closePayModal();
        });
    </script>
    <script>
        <%- include('_common-mobile-script') %>
        <%- include('_common-nav-script') %>
    </script>
</body>
</html>
