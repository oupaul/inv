<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>料件入庫 - <%= typeof title !== 'undefined' ? title : '庫存管理系統' %></title>
    <style>
        <%- include('_common-styles') %>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: "Microsoft JhengHei", "PingFang TC", "Helvetica Neue", Arial, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            background-color: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        
        h1 {
            color: #333;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 3px solid #667eea;
            font-size: 28px;
            font-weight: 600;
        }
        
        nav {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 0;
            border-radius: 8px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            overflow: hidden;
        }
        
        .nav-wrapper {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            padding: 12px 15px;
            gap: 8px;
        }
        
        nav a {
            color: white;
            text-decoration: none;
            padding: 10px 16px;
            border-radius: 6px;
            display: inline-block;
            transition: all 0.3s;
            font-size: 14px;
            font-weight: 500;
            white-space: nowrap;
        }
        
        nav a:hover {
            background-color: rgba(255,255,255,0.2);
            transform: translateY(-2px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }
        
        nav a[href="/users"] {
            background-color: rgba(255,255,255,0.15);
            font-weight: 600;
            border: 1px solid rgba(255,255,255,0.3);
        }
        
        nav a[href="/users"]:hover {
            background-color: rgba(255,255,255,0.25);
        }
        
        nav .auth-link {
            margin-left: auto;
            background-color: rgba(255,255,255,0.2);
            font-weight: 600;
        }
        
        nav .auth-link.logout {
            background-color: #dc3545;
        }
        
        nav .auth-link.login {
            background-color: #007bff;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #555;
            font-size: 14px;
        }
        
        input[type="text"],
        input[type="number"],
        input[type="date"],
        input[type="password"],
        select,
        textarea {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 6px;
            font-size: 14px;
            transition: all 0.3s;
            font-family: inherit;
        }
        
        input:focus,
        select:focus,
        textarea:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        textarea {
            resize: vertical;
            min-height: 100px;
        }
        
        button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }
        
        .flash-messages {
            margin-bottom: 20px;
        }
        
        .flash {
            padding: 15px 20px;
            border-radius: 6px;
            margin-bottom: 10px;
            font-weight: 500;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        
        .flash.success {
            background-color: #d4edda;
            color: #155724;
            border-left: 4px solid #28a745;
        }
        
        .flash.error {
            background-color: #f8d7da;
            color: #721c24;
            border-left: 4px solid #dc3545;
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #999;
        }
        
        .empty-state p {
            font-size: 16px;
            margin-bottom: 10px;
        }
        
        @media (max-width: 768px) {
            .nav-wrapper {
                flex-direction: column;
                align-items: stretch;
            }
            
            nav a {
                width: 100%;
                text-align: center;
                margin-bottom: 5px;
            }
            
            nav .auth-link {
                margin-left: 0;
            }
            
            .container {
                padding: 15px;
            }
            
            /* 表單手機版優化 */
            .form-group {
                margin-bottom: 18px;
            }
            
            input[type="text"],
            input[type="number"],
            input[type="date"],
            select,
            textarea {
                font-size: 16px !important;
                padding: 14px !important;
                -webkit-appearance: none;
            }
            
            button,
            .btn {
                width: 100% !important;
                min-height: 48px !important;
                font-size: 16px !important;
                padding: 14px 20px !important;
                margin-bottom: 10px;
            }
            
            .barcode-input-group {
                flex-direction: column !important;
                gap: 10px !important;
            }
            
            .barcode-input-group input,
            .barcode-input-group button {
                width: 100% !important;
            }
        }
    </style>
</head>
<body>
    <a href="/" class="back-to-home">← 返回主頁</a>
    <%- include('_common-nav') %>
    
    <div class="container">
        <% if (messages && messages.length > 0) { %>
            <div class="flash-messages">
                <% messages.forEach(function(msg) { %>
                    <div class="flash <%= msg.category %>"><%= msg.message %></div>
                <% }); %>
            </div>
        <% } %>
        
        <h1>📥 料件入庫</h1>

        <!-- 無線掃描器使用提示 -->
        <div style="background-color: #d1ecf1; border: 2px solid #17a2b8; border-radius: 8px; padding: 15px; margin-bottom: 20px;">
            <strong style="color: #0c5460; font-size: 15px;">📱 無線掃描器快速入庫：</strong>
            <ul style="margin: 10px 0; padding-left: 20px; color: #0c5460; font-size: 14px; line-height: 1.8;">
                <li><strong>DK-ONE 頸掛式藍芽掃描器</strong>可直接使用！</li>
                <li>確保掃描器已連接，點擊下方「條碼掃描」輸入框使其聚焦</li>
                <li>直接掃描條碼，系統會自動查詢料件並填入表單</li>
                <li>確認數量和日期後，點擊「入庫」按鈕提交</li>
            </ul>
        </div>

        <% if (parts && parts.length > 0) { %>
        <form method="POST" id="inboundForm">
            <div class="form-group">
                <label>條碼掃描</label>
                <div style="margin-bottom: 10px; padding: 15px; background-color: #f8f9fa; border-radius: 6px; border: 2px solid #e0e0e0;">
                    <div style="display: flex; gap: 10px; margin-bottom: 10px; flex-wrap: wrap;">
                        <input type="text" id="barcode-input" placeholder="掃描或輸入條碼" style="flex: 1; min-width: 200px; padding: 10px; border: 2px solid #ddd; border-radius: 6px; font-size: 14px;">
                        <button type="button" id="barcode-scan" style="background: linear-gradient(135deg, #007bff 0%, #0056b3 100%); color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;">📷 掃描</button>
                        <button type="button" id="barcode-lookup" style="background: linear-gradient(135deg, #28a745 0%, #218838 100%); color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;">🔍 查詢</button>
                        <button type="button" id="barcode-clear" style="background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%); color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;">🗑️ 清除</button>
                    </div>
                    <div id="barcode-camera" style="display: none; margin-top: 10px;">
                        <video id="barcode-video" autoplay playsinline style="width: 100%; max-width: 640px; border: 2px solid #667eea; border-radius: 6px;"></video>
                        <button type="button" id="stop-scan" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; margin-top: 10px; font-weight: 600;">停止掃描</button>
                    </div>
                    <div id="barcode-status" style="display: none; padding: 10px; border-radius: 6px; margin-top: 10px;"></div>
                </div>
                <small style="color: #666; margin-top: 5px; display: block;">
                    💡 提示：點擊「掃描」按鈕使用手機攝像頭掃描條碼，或手動輸入條碼後點擊「查詢」。
                </small>
            </div>
            
            <div class="form-group">
                <label for="part_id">選擇料件 *</label>
                <select id="part_id" name="part_id" required>
                    <option value="">-- 請選擇料件 --</option>
                    <% parts.forEach(function(part) { %>
                    <option value="<%= part.id %>" 
                            data-barcode="<%= part.barcode || '' %>"
                            data-part-number="<%= part.part_number %>"
                            data-part-name="<%= part.part_name %>">
                        <%= part.part_number %> - <%= part.part_name %>
                        <% if (part.specification) { %>(<%= part.specification %>)<% } %>
                        <% if (part.category_name) { %> [<%= part.category_name %>]<% } %>
                    </option>
                    <% }); %>
                </select>
                <!-- 即時庫存顯示 -->
                <div id="stock-info-box" style="display:none; margin-top:10px; padding:10px 14px; background:#f0f7ff; border-left:4px solid #667eea; border-radius:6px; font-size:14px;">
                    <span id="stock-info-text"></span>
                </div>
            </div>
            
            <div class="form-group">
                <label for="quantity">入庫數量 *</label>
                <input type="number" id="quantity" name="quantity" required min="1" placeholder="請輸入數量">
            </div>
            
            <div class="form-group">
                <label for="inbound_date">入庫日期 *</label>
                <input type="date" id="inbound_date" name="inbound_date" required value="<%= today %>">
            </div>
            
            <!-- 最終送出用的 hidden inputs（唯一有 name 的歸還相關欄位） -->
            <input type="hidden" id="final_is_return" name="is_return" value="">
            <input type="hidden" id="final_return_outbound_id" name="return_outbound_id" value="">

            <!-- 借測歸還 -->
            <div class="form-group" id="return-section" style="display: none; padding:14px; background:#f0fff4; border:1px solid #6ee7b7; border-radius:8px;">
                <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                    <input type="checkbox" id="is_return" style="width: auto; margin: 0;">
                    <span style="font-weight: 600; color: #065f46;">📥 歸還借測料件</span>
                </label>
                <div id="loan-records-info" style="margin-top: 10px; padding: 10px; background-color: white; border-radius: 6px; display: none;">
                    <div style="font-weight: 600; margin-bottom: 8px; color: #667eea;">未歸還的借測記錄：</div>
                    <div id="loan-records-list"></div>
                    <select id="return_outbound_id" style="margin-top: 10px; display: none; width:100%; padding:8px; border:1px solid #d1d5db; border-radius:6px;">
                        <option value="">-- 選擇要歸還的借測記錄 --</option>
                    </select>
                </div>
            </div>

            <!-- 退回一般出庫 -->
            <div class="form-group" id="outbound-return-section" style="display: none; padding:14px; background:#fffbeb; border:1px solid #fcd34d; border-radius:8px;">
                <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                    <input type="checkbox" id="is_outbound_return" style="width: auto; margin: 0;">
                    <span style="font-weight: 600; color: #78350f;">🔄 退回出庫料件（料件帶回公司重新入庫）</span>
                </label>
                <div id="outbound-records-info" style="margin-top: 12px; display: none;">
                    <div style="font-size:13px; color:#92400e; margin-bottom:8px;">請選擇對應的出庫記錄，系統將自動連結，並在出入庫記錄中顯示「已退回」狀態。</div>
                    <div id="outbound-records-list" style="margin-bottom:8px;"></div>
                    <select id="outbound_return_record_id" style="width:100%; padding:8px; border:1px solid #fcd34d; border-radius:6px; background:#fffbeb;">
                        <option value="">-- 選擇要退回的出庫記錄 --</option>
                    </select>
                </div>
                <small style="color:#92400e; margin-top:6px; display:block;">💡 若找不到對應出庫記錄，可直接以一般入庫方式記錄，不影響庫存計算。</small>
            </div>
            
            <div class="form-group">
                <label for="note">備註</label>
                <textarea id="note" name="note" placeholder="請輸入備註（選填）"></textarea>
            </div>
            
            <button type="submit">確認入庫</button>
            <a href="/" style="margin-left: 10px; color: #666; text-decoration: none;">取消</a>
        </form>
        <% } else { %>
        <div class="empty-state">
            <p>目前沒有任何料件可以入庫</p>
            <p>請先前往<a href="/parts/add">料件管理</a>新增料件</p>
        </div>
        <% } %>
    </div>
    
    <script src="https://unpkg.com/@zxing/library@latest"></script>
    <script>
        const { BrowserMultiFormatReader } = ZXing;
        const codeReader = new BrowserMultiFormatReader();
        let scanning = false;
        
        const barcodeInput = document.getElementById('barcode-input');
        const barcodeScan = document.getElementById('barcode-scan');
        const barcodeLookup = document.getElementById('barcode-lookup');
        const barcodeClear = document.getElementById('barcode-clear');
        const barcodeStatus = document.getElementById('barcode-status');
        const barcodeCamera = document.getElementById('barcode-camera');
        const video = document.getElementById('barcode-video');
        const stopScanBtn = document.getElementById('stop-scan');
        const partSelect = document.getElementById('part_id');
        
        // 掃描按鈕
        barcodeScan.addEventListener('click', async () => {
            if (scanning) return;
            
            try {
                scanning = true;
                barcodeScan.disabled = true;
                barcodeCamera.style.display = 'block';
                showStatus('正在啟動攝像頭...', 'info');
                
                await codeReader.decodeFromVideoDevice(null, 'barcode-video', (result, err) => {
                    if (result) {
                        barcodeInput.value = result.text;
                        showStatus('✓ 掃描成功：' + result.text, 'success');
                        stopScan();
                        
                        // 自動查詢條碼
                        lookupBarcode(result.text);
                    }
                    if (err && !(err instanceof ZXing.NotFoundException)) {
                        console.error(err);
                    }
                });
            } catch (error) {
                showStatus('✗ 無法啟動攝像頭：' + error.message, 'error');
                stopScan();
            }
        });
        
        // 停止掃描
        stopScanBtn.addEventListener('click', () => {
            stopScan();
        });
        
        function stopScan() {
            scanning = false;
            barcodeScan.disabled = false;
            codeReader.reset();
            barcodeCamera.style.display = 'none';
            if (video.srcObject) {
                video.srcObject.getTracks().forEach(track => track.stop());
                video.srcObject = null;
            }
        }
        
        // 查詢條碼
        async function lookupBarcode(barcode) {
            if (!barcode || !barcode.trim()) {
                showStatus('請輸入條碼', 'error');
                setTimeout(() => barcodeInput.focus(), 100);
                return;
            }
            
            try {
                showStatus('正在查詢...', 'info');
                const response = await fetch(`/api/barcode/${encodeURIComponent(barcode)}`);
                const data = await response.json();
                
                if (data.success && data.part) {
                    // 找到料件，自動選擇
                    const option = Array.from(partSelect.options).find(opt => 
                        opt.value == data.part.id
                    );
                    if (option) {
                        partSelect.value = data.part.id;
                        partSelect.dispatchEvent(new Event('change'));
                        showStatus('✓ 找到料件：' + data.part.part_number + ' - ' + data.part.part_name, 'success');
                        // 清空條碼輸入框並重新聚焦，準備下一次掃描
                        setTimeout(() => {
                            barcodeInput.value = '';
                            barcodeInput.focus();
                        }, 300);
                    } else {
                        showStatus('✗ 料件不在列表中', 'error');
                        setTimeout(() => {
                            barcodeInput.select();
                            barcodeInput.focus();
                        }, 1500);
                    }
                } else {
                    showStatus('✗ 未找到對應的料件', 'error');
                    setTimeout(() => {
                        barcodeInput.select();
                        barcodeInput.focus();
                    }, 1500);
                }
            } catch (error) {
                showStatus('✗ 查詢失敗：' + error.message, 'error');
                setTimeout(() => barcodeInput.focus(), 100);
            }
        }
        
        // 查詢按鈕
        barcodeLookup.addEventListener('click', () => {
            const barcode = barcodeInput.value.trim();
            if (barcode) {
                lookupBarcode(barcode);
            } else {
                showStatus('請先輸入或掃描條碼', 'error');
            }
        });
        
        // 條碼輸入框按 Enter 時自動查詢
        barcodeInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                lookupBarcode(barcodeInput.value.trim());
            }
        });
        
        // 清除按鈕
        barcodeClear.addEventListener('click', () => {
            // 清空條碼輸入框
            barcodeInput.value = '';
            // 清除狀態顯示
            barcodeStatus.style.display = 'none';
            barcodeStatus.textContent = '';
            // 重置料件選擇
            partSelect.value = '';
            partSelect.dispatchEvent(new Event('change'));
            // 清除數量輸入
            const quantityInput = document.getElementById('quantity');
            if (quantityInput) {
                quantityInput.value = '';
            }
            // 清除歸還相關區塊
            const returnSection = document.getElementById('return-section');
            if (returnSection) {
                returnSection.style.display = 'none';
            }
            const isReturnCheckbox = document.getElementById('is_return');
            if (isReturnCheckbox) {
                isReturnCheckbox.checked = false;
            }
            // 重新聚焦到條碼輸入框
            barcodeInput.focus();
        });
        
        // 料件選擇相關元素
        const returnSection          = document.getElementById('return-section');
        const isReturnCheckbox       = document.getElementById('is_return');
        const loanRecordsInfo        = document.getElementById('loan-records-info');
        const loanRecordsList        = document.getElementById('loan-records-list');
        const returnOutboundSelect   = document.getElementById('return_outbound_id');

        const outboundReturnSection  = document.getElementById('outbound-return-section');
        const isOutboundReturnCb     = document.getElementById('is_outbound_return');
        const outboundRecordsInfo    = document.getElementById('outbound-records-info');
        const outboundRecordsList    = document.getElementById('outbound-records-list');
        const outboundReturnSelect   = document.getElementById('outbound_return_record_id');

        // 唯一實際送出的 hidden inputs
        const finalIsReturn        = document.getElementById('final_is_return');
        const finalReturnOutboundId = document.getElementById('final_return_outbound_id');

        function setFinalReturnFields(isReturn, outboundId) {
            finalIsReturn.value        = isReturn ? 'on' : '';
            finalReturnOutboundId.value = outboundId || '';
        }

        function resetReturnSections() {
            returnSection.style.display = 'none';
            isReturnCheckbox.checked = false;
            loanRecordsInfo.style.display = 'none';
            returnOutboundSelect.style.display = 'none';
            returnOutboundSelect.value = '';

            outboundReturnSection.style.display = 'none';
            isOutboundReturnCb.checked = false;
            outboundRecordsInfo.style.display = 'none';
            outboundReturnSelect.value = '';

            setFinalReturnFields(false, '');
        }

        partSelect.addEventListener('change', async () => {
            const partId = partSelect.value;
            const stockBox = document.getElementById('stock-info-box');
            const stockText = document.getElementById('stock-info-text');

            resetReturnSections();
            if (!partId) {
                if (stockBox) stockBox.style.display = 'none';
                return;
            }

            // 顯示即時庫存
            if (stockBox && stockText) {
                try {
                    const resp = await fetch(`/api/parts/${partId}/detail`);
                    const d = await resp.json();
                    if (d.success && d.part) {
                        const st = d.part.current_stock;
                        const mn = d.part.min_stock || 0;
                        const warn = mn > 0 && st <= mn ? ` ⚠️ 低於最低庫存（${mn}）` : '';
                        const color = st <= 0 ? '#dc3545' : (mn > 0 && st <= mn ? '#ff9800' : '#28a745');
                        stockText.innerHTML = `📦 <strong>${d.part.part_name}</strong> 目前庫存：<strong style="color:${color};font-size:16px;">${st}</strong> ${d.part.unit}${warn}`;
                        stockBox.style.display = 'block';
                        stockBox.style.borderLeftColor = color;
                    }
                } catch(e) { stockBox.style.display = 'none'; }
            }

            // 查詢借測未歸還記錄
            try {
                const res1 = await fetch(`/api/loan-records/${partId}`);
                const loan = await res1.json();
                if (loan.success && loan.records && loan.records.length > 0) {
                    returnSection.style.display = 'block';
                    loanRecordsInfo.style.display = 'block';
                    let html = '';
                    returnOutboundSelect.innerHTML = '<option value="">-- 選擇要歸還的借測記錄 --</option>';
                    loan.records.forEach(r => {
                        html += `<div style="padding:7px 10px; margin-bottom:5px; background:white; border-left:3px solid #667eea; border-radius:4px; font-size:13px;">
                            <strong>借測日期：</strong>${r.outbound_date} | <strong>數量：</strong>${r.quantity} | <strong>未歸還：</strong>${r.remaining_quantity}
                            ${r.note ? `<br><small style="color:#666;">備註：${r.note}</small>` : ''}
                        </div>`;
                        const opt = document.createElement('option');
                        opt.value = r.id;
                        opt.textContent = `${r.outbound_date} - 數量：${r.quantity}（未歸還：${r.remaining_quantity}）`;
                        returnOutboundSelect.appendChild(opt);
                    });
                    loanRecordsList.innerHTML = html;
                }
            } catch(e) { console.error('查詢借測記錄失敗:', e); }

            // 查詢一般出庫可退回記錄
            try {
                const res2 = await fetch(`/api/outbound-records/${partId}`);
                const ob = await res2.json();
                if (ob.success && ob.records && ob.records.length > 0) {
                    outboundReturnSection.style.display = 'block';
                    let html = '';
                    outboundReturnSelect.innerHTML = '<option value="">-- 選擇要退回的出庫記錄 --</option>';
                    ob.records.forEach(r => {
                        html += `<div style="padding:7px 10px; margin-bottom:5px; background:white; border-left:3px solid #f59e0b; border-radius:4px; font-size:13px;">
                            <strong>出庫日期：</strong>${r.outbound_date} | <strong>出庫數量：</strong>${r.quantity} | <strong>可退回：</strong><span style="color:#d97706; font-weight:700;">${r.remaining_qty}</span>
                            ${r.note ? `<br><small style="color:#666;">備註：${r.note}</small>` : ''}
                            ${r.created_by ? `<small style="color:#999; margin-left:8px;">操作人：${r.created_by}</small>` : ''}
                        </div>`;
                        const opt = document.createElement('option');
                        opt.value = r.id;
                        opt.textContent = `${r.outbound_date} - 出庫 ${r.quantity}，可退回 ${r.remaining_qty}${r.note ? '（'+r.note+'）' : ''}`;
                        outboundReturnSelect.appendChild(opt);
                    });
                    outboundRecordsList.innerHTML = html;
                }
            } catch(e) { console.error('查詢出庫記錄失敗:', e); }
        });

        // 借測歸還勾選事件
        isReturnCheckbox.addEventListener('change', () => {
            if (isReturnCheckbox.checked) {
                // 互斥：取消退回出庫勾選
                isOutboundReturnCb.checked = false;
                outboundRecordsInfo.style.display = 'none';

                returnOutboundSelect.style.display = 'block';
                returnOutboundSelect.required = true;
                // 更新 final hidden fields
                setFinalReturnFields(true, returnOutboundSelect.value);
            } else {
                returnOutboundSelect.style.display = 'none';
                returnOutboundSelect.required = false;
                returnOutboundSelect.value = '';
                setFinalReturnFields(false, '');
            }
        });

        // 借測記錄選擇事件
        returnOutboundSelect.addEventListener('change', () => {
            if (isReturnCheckbox.checked) {
                setFinalReturnFields(true, returnOutboundSelect.value);
            }
        });

        // 退回出庫勾選事件
        isOutboundReturnCb.addEventListener('change', () => {
            if (isOutboundReturnCb.checked) {
                // 互斥：取消借測歸還勾選
                isReturnCheckbox.checked = false;
                returnOutboundSelect.style.display = 'none';
                returnOutboundSelect.required = false;
                returnOutboundSelect.value = '';

                outboundRecordsInfo.style.display = 'block';
                setFinalReturnFields(true, outboundReturnSelect.value);
            } else {
                outboundRecordsInfo.style.display = 'none';
                setFinalReturnFields(false, '');
            }
        });

        // 退回出庫記錄選擇事件
        outboundReturnSelect.addEventListener('change', () => {
            if (isOutboundReturnCb.checked) {
                setFinalReturnFields(true, outboundReturnSelect.value);
            }
        });

        // 表單送出前驗證
        document.querySelector('form').addEventListener('submit', function(e) {
            if (isReturnCheckbox.checked && !returnOutboundSelect.value) {
                e.preventDefault();
                alert('請選擇要歸還的借測記錄');
                returnOutboundSelect.focus();
                return;
            }
            if (isOutboundReturnCb.checked) {
                if (!outboundReturnSelect.value) {
                    e.preventDefault();
                    alert('請選擇要退回的出庫記錄');
                    outboundReturnSelect.focus();
                    return;
                }
                // 確保最終 hidden inputs 為最新值
                setFinalReturnFields(true, outboundReturnSelect.value);
            }
        });
        
        // 顯示狀態訊息
        function showStatus(message, type) {
            barcodeStatus.textContent = message;
            barcodeStatus.style.display = 'block';
            barcodeStatus.className = '';
            if (type === 'success') {
                barcodeStatus.style.backgroundColor = '#d4edda';
                barcodeStatus.style.color = '#155724';
                barcodeStatus.style.borderLeft = '4px solid #28a745';
            } else if (type === 'error') {
                barcodeStatus.style.backgroundColor = '#f8d7da';
                barcodeStatus.style.color = '#721c24';
                barcodeStatus.style.borderLeft = '4px solid #dc3545';
            } else {
                barcodeStatus.style.backgroundColor = '#d1ecf1';
                barcodeStatus.style.color = '#0c5460';
                barcodeStatus.style.borderLeft = '4px solid #17a2b8';
            }
        }
        
        // 初始化：確保條碼輸入框聚焦（支援無線掃描器）
        function ensureBarcodeFocus() {
            if (barcodeInput) {
                barcodeInput.focus();
                // 將輸入框滾動到可視區域
                barcodeInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }
        
        // 頁面加載完成後立即聚焦
        ensureBarcodeFocus();
        
        // DOM 完全加載後再次聚焦（確保其他腳本不會影響）
        setTimeout(ensureBarcodeFocus, 500);
        
        // 當用戶點擊頁面其他地方後，如果沒有選中任何輸入框，自動回到條碼輸入框
        document.addEventListener('click', (e) => {
            // 如果點擊的不是輸入框、按鈕或連結，則自動聚焦到條碼輸入框
            if (!e.target.matches('input, button, a, select, textarea')) {
                setTimeout(() => barcodeInput.focus(), 50);
            }
        });
    </script>
</body>
</html>

